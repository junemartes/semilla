=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== both src/lib.rs
macro_rules! cfg_if {
    (if #[cfg($m:meta)] { $($a:item)* } else { $($b:item)* }) => {
        $(#[cfg($m)] $a)*
        $(#[cfg(not($m))] $b)*
    };
}

cfg_if! {
    if #[cfg(unix)] {
        mod imp;
    } else {
        mod imp;
    }
}
