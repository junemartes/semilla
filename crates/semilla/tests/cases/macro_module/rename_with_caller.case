=== old src/lib.rs
macro_rules! pick {
    ($($t:tt)*) => { $($t)* };
}

pick! {
    pub mod unix;
}

pub fn run() -> u32 {
    unix::open() + 1
}
=== new src/lib.rs
macro_rules! pick {
    ($($t:tt)*) => { $($t)* };
}

pick! {
    pub mod unix;
}

pub fn run() -> u32 {
    unix::start() + 1
}
=== old src/unix.rs
