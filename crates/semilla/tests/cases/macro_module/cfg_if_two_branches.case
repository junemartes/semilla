note: a macro like `cfg_if!` with two branches: each branch names its own file, and each file has the facts of its items
rule-: R59.1-7
rule+: R59.1-3
=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== both src/lib.rs
macro_rules! cfg_if {
    (if #[cfg($m:meta)] { $($a:item)* } else { $($b:item)* }) => {
        $(#[cfg($m)] $a)*
        $(#[cfg(not($m))] $b)*
    };
}

cfg_if! {
    if #[cfg(unix)] {
        mod unix;
        pub use unix::open;
    } else {
        mod other;
        pub use other::open;
    }
}
=== old src/unix.rs
pub fn open() -> u32 {
    3
}
=== new src/unix.rs
