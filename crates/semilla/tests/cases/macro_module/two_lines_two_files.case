note: A-g: two lines of one name with two files give twin modules `imp#0` and `imp#1`
rule+: R59.1-7
=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== both src/lib.rs
macro_rules! cfg_if {
    (if #[cfg($m:meta)] { $($a:item)* } else { $($b:item)* }) => {
        $(#[cfg($m)] $a)*
        $(#[cfg(not($m))] $b)*
    };
}

cfg_if! {
    if #[cfg(unix)] {
        #[path = "unix.rs"]
        mod imp;
    } else {
        #[path = "other.rs"]
        mod imp;
    }
}
