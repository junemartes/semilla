macro_rules! cfg_if {
    (if #[cfg($m:meta)] { $($a:item)* } else { $($b:item)* }) => {
        $(#[cfg($m)] $a)*
        $(#[cfg(not($m))] $b)*
    };
}

cfg_if! {
    if #[cfg(unix)] {
        #[path = "unix.rs"]
        mod imp;
    } else {
        #[path = "other.rs"]
        mod imp;
    }
}
