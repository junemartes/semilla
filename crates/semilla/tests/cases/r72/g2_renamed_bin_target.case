pub fn total(v: &[u32]) -> u32 {
    assert!(!v.is_empty());
    v.iter().sum()
}
=== both src/main.rs
fn main() {
    let v = vec![1, 2, 3];
    println!("{}", shop::total(&v));
    assert_eq!(shop::total(&v), 6);
}
