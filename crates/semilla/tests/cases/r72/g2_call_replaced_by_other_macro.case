pub fn make(n: u32) -> Vec<u32> {
    let label = format!("n = {}", n);
    let _ = label;
    Vec::new()
}
=== new src/lib.rs
pub fn make(n: u32) -> Vec<u32> {
    let label = String::new();
    let _ = label;
    vec![n, n + 1, n + 2]
}
