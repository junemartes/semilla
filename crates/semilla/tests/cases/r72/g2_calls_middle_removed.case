=== old src/lib.rs
pub fn report(a: u32, b: u32) -> Vec<String> {
    let mut out = Vec::new();
    out.push(format!("first {}", a));
    out.push(format!("middle {} {}", a, b));
    out.push(format!("last {}", b));
    out
}
=== new src/lib.rs
pub fn report(a: u32, b: u32) -> Vec<String> {
    let mut out = Vec::new();
    out.push(format!("first {}", a));
    out.push(format!("last {}", b));
    out
}
