pub struct W<T>(pub T);
impl W<u32> {
    pub fn get(&self) -> u32 { self.0 }
}
impl W<u8> {
    pub fn get(&self) -> u8 { self.0 + 1 }
}
impl W<u16> {
    pub fn get(&self) -> u16 { self.0 + 2 }
}
