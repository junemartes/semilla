=== new src/lib.rs
#[cfg(unix)]
pub fn path_sep() -> char {
    '/'
}
#[cfg(target_os = "wasi")]
pub fn path_sep() -> Option<String> {
    let found = std::env::var("SEP").ok()?;
    let trimmed = found.trim().to_string();
    if trimmed.is_empty() {
        return None;
    }
    let first = trimmed.chars().next()?;
    Some(first.to_string())
}
