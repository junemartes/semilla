=== old src/list.rs
//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[0] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}
=== new src/list/mod.rs
//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[0] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    // Take the larger one.
    let m = max(a, b);
    m
}
