//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}

pub fn last(v: &[u32]) -> u32 { v[v.len() - 1] }
