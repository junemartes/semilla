//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[0] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}
pub fn f0() -> u32 {
    let k = 1;
    k
}

pub fn f1() -> u32 {
    let k = 1;
    k
}

