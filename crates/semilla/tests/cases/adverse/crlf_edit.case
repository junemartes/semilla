=== old src/list.rs (each line ends with CR LF)
//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[0] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}
=== new src/list.rs (each line ends with CR LF)
//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[1] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}
