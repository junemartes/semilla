=== old src/lib.rs
fn step(x: u32) -> u32 {
    x * 2
}

pub fn caller(x: u32) -> u32 {
    step(x) + 1
}
=== new src/lib.rs
fn step(x: u32) -> u32 {
    x * 3
}

pub fn caller(x: u32) -> u32 {
    step(x) + 1
}
