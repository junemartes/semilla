=== old src/lib.rs
pub struct Meters(pub u32);

impl std::fmt::Debug for Meters {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} m", self.0)
    }
}

pub fn walk(x: u32) -> Meters {
    Meters(x / 2)
}
=== new src/lib.rs
pub struct Meters(pub u32);

impl std::fmt::Debug for Meters {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} m", self.0)
    }
}

pub fn walk(x: u32) -> Meters {
    Meters(x >> 2)
}
