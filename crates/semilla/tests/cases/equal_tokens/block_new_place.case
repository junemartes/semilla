=== old src/lib.rs
fn check(p: *const u32) -> u32 { p as u32 }
pub fn read(p: *const u32) -> u32 {
    unsafe {
        check(p)
            .wrapping_add(1)
    }
}
=== new src/lib.rs
fn check(p: *const u32) -> u32 { p as u32 }
pub fn read(p: *const u32) -> u32 {
    let n = check(p);
    unsafe { n.wrapping_add(2) }
}
