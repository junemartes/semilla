=== old src/lib.rs
fn g(x: u32, y: u32) -> u32 { x + y }
pub fn total(a: u32, b: u32) -> u32 {
    a + g(
        1,
        b,
    )
}
=== new src/lib.rs
fn g(x: u32, y: u32) -> u32 { x + y }
pub fn total(a: u32, b: u32) -> u32 {
    a - g(
        1,
        b
    )
}
