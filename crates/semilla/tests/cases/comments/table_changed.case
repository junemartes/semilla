=== old src/lib.rs
// The map of the sums.
use std::collections::BTreeMap;
/// A: is not inline.
pub fn a() -> BTreeMap<u32, u32> { BTreeMap::new() }
/// B: is private.
fn b() -> u32 { 2 }
/// D: says "ten".
pub fn d() -> &'static str { "ten" }
/// E: prints one value.
pub fn e(x: u32) { println!("{}", x); let _ = b(); }
=== new src/lib.rs
// The map of the sums.
use std::collections::{BTreeMap, BTreeSet};
/// A: is not inline.
#[inline]
pub fn a() -> BTreeMap<u32, u32> { let _: BTreeSet<u32> = BTreeSet::new(); BTreeMap::new() }
/// B: is private.
pub fn b() -> u32 { 2 }
/// D: says "ten".
pub fn d() -> &'static str { "five" }
/// E: prints one value.
pub fn e(x: u32) { println!("{} {}", x, x); let _ = b(); }
