/// Gives the sum of the prices with the tax.
pub fn total(prices: &[u32]) -> u32 {
    let mut sum = 0; // Start at zero.
    // Add each price one time.
    for price in prices {
        // The tax is 10 percent.
        sum += price + price / 5;
    }
    sum
}
