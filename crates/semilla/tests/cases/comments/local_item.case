=== old src/lib.rs
/// Gives the price with a tax of 10 percent.
pub fn price(x: u32) -> u32 {
    // The limit of the price.

    use core::cmp::min;
    use core::cmp::max;
    max(min(x, 100), 1) + x / 10
}
/// Gives the fee.
pub fn fee(x: u32) -> u32 {
    /// Gives one tenth.
    fn part(x: u32) -> u32 {
        x / 10
    }
    part(x)
}
=== new src/lib.rs
/// Gives the price with a tax of 10 percent.
pub fn price(x: u32) -> u32 {
    // The limit of the price.
    use core::cmp::min;
    min(x, 100) + x / 10
}
/// Gives the fee.
pub fn fee(x: u32) -> u32 {
    /// Gives one tenth.
    fn part(x: u32) -> u32 {
        x / 5
    }
    part(x)
}
