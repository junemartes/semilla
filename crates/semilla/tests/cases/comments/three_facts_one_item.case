=== old src/lib.rs
/// Gives the price with a tax of 10 percent.
pub fn price(x: u32, n: u32) -> u32 {
    let tax = x / 10;
    // One unit more for the box.
    let count = n + 1;
    (x + tax) * count
}
=== new src/lib.rs
/// Gives the price with a tax of 10 percent.
pub fn price(x: u64, n: u64) -> u64 {
    let tax = x / 5;
    // One unit more for the box.
    let count = n + 2;
    (x + tax) * count
}
