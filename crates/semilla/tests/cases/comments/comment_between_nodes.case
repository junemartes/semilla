=== old src/lib.rs
pub fn price(x: u32, n: u32) -> u32 {
    // The tax is 10 percent.
    let tax = x / 10;
    // The count has one unit more.
    let count = n + 1;
    (x + tax) * count
}
=== new src/lib.rs
pub fn price(x: u32, n: u32) -> u32 {
    // The tax is 10 percent.
    let tax = x / 5;
    // The count has one unit more.
    let count = n + 1;
    (x + tax) * count
}
