=== old src/lib.rs
pub struct Cart { pub total: u32 }
// The price rules of a cart.
impl Cart {
    /// Gives the price with a tax of 10 percent.
    pub fn price(&self) -> u32 {
        self.total + self.total / 10
    }
    /// Gives the count.
    pub fn count(&self) -> u32 { 1 }
}
=== new src/lib.rs
pub struct Cart { pub total: u32 }
// The price rules of a cart.
impl Cart {
    /// Gives the price with a tax of 10 percent.
    pub fn price(&self) -> u32 {
        self.total + self.total / 5
    }
    /// Gives the count.
    pub fn count(&self) -> u32 { 1 }
}
