=== old src/lib.rs
/* The tax is 10 percent.

   It applies to each unit. */
pub fn price(x: u32) -> u32 {
    // This line is long: the tax is 10 percent today, and the law can change it to a different value at the start of each year.
    x + x / 10 /* ten */
}
