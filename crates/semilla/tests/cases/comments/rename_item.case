}
=== new src/lib.rs
/// `price` gives the price with the tax.
pub fn cost(x: u32) -> u32 {
    x + x / 10
}
/// Gives the price of two.
pub fn two(x: u32) -> u32 {
    cost(x) + cost(x)
}
