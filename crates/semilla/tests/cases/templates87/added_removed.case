=== old src/lib.rs
pub struct Bag { pub n: u32 }
pub struct Shelf<V> { pub items: Vec<V> }
pub trait Weigh { fn weigh(&self) -> u32 { 0 } fn tare(&self) -> u32 { 0 } }
pub fn gone(x: u32) -> u32 { x }
impl Bag { pub fn gone_half(&self) -> u32 { self.n / 2 } }
impl<V> Shelf<V> { pub fn gone_len(&self) -> usize { self.items.len() } }
impl Weigh for Bag { fn weigh(&self) -> u32 { self.n } }
=== new src/lib.rs
pub struct Bag { pub n: u32 }
pub struct Shelf<V> { pub items: Vec<V> }
pub trait Weigh { fn weigh(&self) -> u32 { 0 } fn tare(&self) -> u32 { 0 } }
pub fn fresh_sum(x: u32, y: u64) -> u64 { x as u64 + y }
impl Bag { pub fn fresh_twice(&self) -> u32 { self.n * 2 } }
impl<V> Shelf<V> { pub fn fresh_empty(&self) -> bool { self.items.is_empty() } }
impl Weigh for Bag { fn tare(&self) -> u32 { 1 } }
