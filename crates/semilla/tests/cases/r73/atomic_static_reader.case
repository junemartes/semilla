=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
use std::sync::atomic::{AtomicU32, Ordering};

pub static COUNT: AtomicU32 = AtomicU32::new(5);
pub static TABLE: [u32; 3] = [1, 2, 3];

pub fn get() -> u32 {
    COUNT.load(Ordering::Relaxed)
}

pub fn first() -> u32 {
    TABLE[0]
}

pub fn other() -> u32 {
    3
}
=== new src/lib.rs
use std::sync::atomic::{AtomicU32, Ordering};

pub static COUNT: AtomicU32 = AtomicU32::new(7);
pub static TABLE: [u32; 3] = [1, 2, 3];

pub fn get() -> u32 {
    COUNT.load(Ordering::Relaxed)
}

pub fn first() -> u32 {
    TABLE[0]
}

pub fn other() -> u32 {
    3
}
