=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
macro_rules! base { () => { 7 } }

pub fn scale<T: Into<u64>>(k: T) -> u64 {
    k.into() * 3
}

pub fn price(n: u32) -> u64 {
    let k = n as u16;
    let base = base!();
    let s = scale(k);
    let t = (0..base).map(|i| i + s).sum::<u64>();
    s + t
}
=== new src/lib.rs
macro_rules! base { () => { 8 } }

pub fn scale<T: Into<u64>>(k: T) -> u64 {
    k.into() * 3
}

pub fn price(n: u32) -> u64 {
    let k = n;
    let base = base!();
    let s = scale(k);
    let t = (0..base).map(|i| i + s).sum::<u64>();
    s + t
}
