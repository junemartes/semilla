=== both depot/src/lib.rs
use proc_macro::TokenStream;

#[proc_macro_attribute]
pub fn tag(_attr: TokenStream, item: TokenStream) -> TokenStream {
    item
}
=== both shop/Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"

[dependencies]
depot = { path = "../depot" }
