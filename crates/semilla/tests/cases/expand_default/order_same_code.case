=== both depot/Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"

[lib]
proc-macro = true
=== both depot/src/lib.rs
use proc_macro::TokenStream;

#[proc_macro_derive(Marker)]
pub fn marker(input: TokenStream) -> TokenStream {
    // Only the name of the type: the code does not read the fields.
    let text = input.to_string();
    let name = text.split_whitespace().skip_while(|word| *word != "struct").nth(1).unwrap_or("X").to_string();
    format!("impl {name} {{ pub fn marked() -> bool {{ true }} }}").parse().unwrap()
}
=== both shop/Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"

[dependencies]
depot = { path = "../depot" }
=== old shop/src/lib.rs
#[derive(depot::Marker)]
pub struct Item {
    pub a: u8,
    pub b: u32,
}
=== new shop/src/lib.rs
#[derive(depot::Marker)]
pub struct Item {
    pub b: u32,
    pub a: u8,
}
