=== old src/lib.rs
mod block;

use block::Block as SimdBlock;

pub type Block = usize;

pub(crate) const BITS: usize = core::mem::size_of::<Block>() * 8;

pub struct Bits {
    data: Vec<SimdBlock>,
    length: usize,
}

impl Bits {
    pub fn with_capacity_and_blocks<I: IntoIterator<Item = Block>>(bits: usize, blocks: I) -> Self {
        let words = blocks.into_iter().count();
        let length = bits.min(words * BITS);
        Bits { data: vec![SimdBlock::NONE; length / SimdBlock::BITS + 1], length }
    }

    /// # Safety
    /// `subblock` is in bounds.
    pub unsafe fn get_unchecked(&self, subblock: usize) -> &Block {
        &*self.data.as_ptr().cast::<Block>().add(subblock)
    }

    pub fn len(&self) -> usize {
        self.length
    }

    pub fn blocks(&self) -> usize {
        self.data.len() * SimdBlock::USIZE_COUNT
    }
}
=== new src/lib.rs
mod block;

use block::Block as SimdBlock;

pub type Block = usize;

pub(crate) const BITS: usize = core::mem::size_of::<Block>() * 8;

pub struct Bits {
    data: Vec<SimdBlock>,
    length: usize,
}

impl Bits {
    pub fn with_capacity_and_blocks<I: IntoIterator<Item = Block>>(bits: usize, blocks: I) -> Self {
        let words = blocks.into_iter().count();
        let first: Block = 0;
        let length = bits.min(words * BITS + first);
        Bits { data: vec![SimdBlock::NONE; length / SimdBlock::BITS + 1], length }
    }

    /// # Safety
    /// `subblock` is in bounds.
    pub unsafe fn get_unchecked(&self, index: usize) -> &Block {
        &*self.data.as_ptr().cast::<Block>().add(index)
    }

    pub fn len(&self) -> usize {
        self.length
    }

    pub fn first_block(&self) -> Block {
        if self.data.is_empty() || self.data[0] == SimdBlock::NONE {
            return 0;
        }
        let words: &[Block] = unsafe { core::slice::from_raw_parts(self.data.as_ptr().cast::<Block>(), SimdBlock::USIZE_COUNT) };
        words[0] | (SimdBlock::BITS as Block)
    }

    pub fn blocks(&self) -> usize {
        let count = self.data.len();
        count * SimdBlock::USIZE_COUNT
    }
}
