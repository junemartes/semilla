#[derive(Copy, Clone, Debug, PartialEq, Eq)]
pub struct Block([usize; 4]);

impl Block {
    pub const USIZE_COUNT: usize = 4;
    pub const NONE: Self = Block([0; 4]);
    pub const BITS: usize = core::mem::size_of::<Self>() * 8;

    pub fn is_empty(self) -> bool {
        self == Self::NONE
    }
}
