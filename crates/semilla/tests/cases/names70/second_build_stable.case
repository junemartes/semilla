=== new src/lib.rs
mod a {
    pub(crate) struct Block {
        pub y: u16,
    }

    pub(crate) fn make() -> Block {
        Block { y: 2 }
    }
}

mod b {
    pub struct Block(pub u16);
}

use b as c;
pub use c::Block;

pub fn make() -> u32 {
    a::make().y as u32
}
