=== old src/lib.rs
pub type Block = usize;

pub mod simd {
    #[cfg(target_feature = "avx512f")]
    pub struct Block(pub [u64; 8]);
}

pub fn width(b: Block) -> Block {
    b + 1
}
=== new src/lib.rs
pub type Block = usize;

pub mod simd {
    #[cfg(target_feature = "avx512f")]
    pub struct Block(pub [u64; 8]);
}

pub fn width(b: Block) -> Block {
    let n: Block = b * 2;
    n + 1
}
