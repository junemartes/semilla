fn main() {
    let rustc = std::env::var("RUSTC").unwrap_or_else(|_| "rustc".to_string());
    let version = std::process::Command::new(rustc).arg("-V").output().map(|out| String::from_utf8_lossy(&out.stdout).to_string()).unwrap_or_default();
    if version.contains("nightly") {
        panic!("this crate does not build with a nightly compiler");
    }
}
