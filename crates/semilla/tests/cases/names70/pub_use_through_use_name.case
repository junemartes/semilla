[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
mod a {
    pub(crate) struct Block {
        x: u8,
        pub y: u8,
    }

    impl Block {
        pub fn new() -> Block {
            Block { x: 1, y: 2 }
        }
        pub fn sum(&self) -> u32 {
            self.x as u32 + self.y as u32
        }
    }
}

mod b {
    pub struct Block(pub u16);
}

use b as c;
pub use c::Block;

pub fn make() -> u32 {
    a::Block::new().sum()
}
=== new src/lib.rs
mod a {
    pub(crate) struct Block {
        x: u16,
        pub y: u16,
    }

    impl Block {
        pub fn new() -> Block {
            Block { x: 1, y: 2 }
        }
        pub fn sum(&self) -> u32 {
            self.x as u32 + self.y as u32
        }
    }
}

mod b {
    pub struct Block(pub u16);
}

use b as c;
pub use c::Block;

pub fn make() -> u32 {
    a::Block::new().sum()
}
