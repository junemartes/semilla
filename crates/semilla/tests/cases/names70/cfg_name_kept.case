    b + 1
}
=== new src/lib.rs
#[cfg(not(target_feature = "avx512f"))]
mod wide {
    pub fn make() -> usize {
        8
    }
}

macro_rules! skip {
    ($($t:tt)*) => {
        0
    };
}

pub fn width(b: usize) -> usize {
    b + skip!(wide::make()) + 1
}
