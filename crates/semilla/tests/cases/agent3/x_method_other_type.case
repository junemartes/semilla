=== old src/lib.rs
pub mod money {
    use std::fmt;
    pub struct Price(pub u64);
    pub trait Scale<T> { fn scale(&self, by: T) -> Self; }
    impl fmt::Display for Price {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { write!(f, "{}", self.0) }
    }
    impl fmt::Debug for Price {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { write!(f, "P{}", self.0) }
    }
    impl Scale<u64> for Price { fn scale(&self, by: u64) -> Self { Price(self.0 * by) } }
    impl Scale<u32> for Price { fn scale(&self, by: u32) -> Self { Price(self.0 * by as u64) } }
    impl Price { pub fn cents(&self) -> u64 { self.0 } }
    impl<T: Copy, const N: usize> Scale<[T; N]> for Price { fn scale(&self, _by: [T; N]) -> Self { Price(self.0 + 7) } }
}
pub mod stock {
    pub struct Bin(pub u32);
    impl std::fmt::Display for Bin {
        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f, "bin {}", self.0) }
    }
}
pub enum Mode { Idle, Busy }
pub fn mode_name(m: &Mode) -> &'static str { match m { Mode::Idle => "idle", Mode::Busy => "busy" } }
pub fn start() -> Mode { Mode::Idle }
pub fn limit() -> u32 { 10 }
pub fn uses_limit() -> u32 { limit() + limit() }
pub fn wrap(x: u32) -> u32 { x }
pub fn wrap2(x: u32) -> u32 { x }
pub struct Cart { pub total: u32 }
pub fn a(c: &Cart) -> u32 { wrap(c.total + 1) }
pub fn b(c: &Cart) -> u32 { wrap(c.total * 2) }
pub fn guard(v: &mut Vec<u8>) -> usize {
    struct G<'a>(&'a mut Vec<u8>);
    impl Drop for G<'_> {
        fn drop(&mut self) {
            let mut index = 0;
            loop {
                if index >= self.0.len() {
                    return;
                }
                self.0[index] = 0;
                index += 1;
            }
        }
    }
    let g = G(v);
    g.0.len()
}
=== new src/lib.rs
pub mod money {
    use std::fmt;
    pub struct Price(pub u64);
    pub trait Scale<T> { fn scale(&self, by: T) -> Self; }
    impl fmt::Display for Price {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { write!(f, "{}", self.0) }
    }
    impl fmt::Debug for Price {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { write!(f, "P{}", self.0) }
    }
    impl Scale<u64> for Price { fn scale(&self, by: u64) -> Self { Price(self.0 * by) } }
    impl Scale<u32> for Price { fn scale(&self, by: u32) -> Self { Price(self.0 * by as u64) } }
    impl Price { }
    impl super::stock::Bin { pub fn cents(&self) -> u64 { self.0 as u64 } }
    impl<T: Copy, const N: usize> Scale<[T; N]> for Price { fn scale(&self, _by: [T; N]) -> Self { Price(self.0 + 7) } }
}
pub mod stock {
    pub struct Bin(pub u32);
    impl std::fmt::Display for Bin {
        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f, "bin {}", self.0) }
    }
}
pub enum Mode { Idle, Busy }
pub fn mode_name(m: &Mode) -> &'static str { match m { Mode::Idle => "idle", Mode::Busy => "busy" } }
pub fn start() -> Mode { Mode::Idle }
pub fn limit() -> u32 { 10 }
pub fn uses_limit() -> u32 { limit() + limit() }
pub fn wrap(x: u32) -> u32 { x }
pub fn wrap2(x: u32) -> u32 { x }
pub struct Cart { pub total: u32 }
pub fn a(c: &Cart) -> u32 { wrap(c.total + 1) }
pub fn b(c: &Cart) -> u32 { wrap(c.total * 2) }
pub fn guard(v: &mut Vec<u8>) -> usize {
    struct G<'a>(&'a mut Vec<u8>);
    impl Drop for G<'_> {
        fn drop(&mut self) {
            let mut index = 0;
            loop {
                if index >= self.0.len() {
                    return;
                }
                self.0[index] = 0;
                index += 1;
            }
        }
    }
    let g = G(v);
    g.0.len()
}
