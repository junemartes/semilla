=== old src/lib.rs
pub enum Mode { Idle, Busy, Done }
pub struct Pair { pub left: u32, pub right: u8 }
#[derive(PartialEq, PartialOrd)]
pub enum Level { Low, High }
pub fn limit() -> u32 { 10 }
pub fn total(a: bool, b: &bool, v: &[u32]) -> u32 {
    let mut n = 0;
    if a & &*b { n += 1; }
    let s = "a  b";
    n += s.len() as u32;
    for x in v { n += x; }
    n
}
macro_rules! twice { ($e:expr) => { $e * 2 }; }
pub fn double() -> u32 { twice!(limit()) }
pub trait Shape { fn area(&self) -> u32; fn sides(&self) -> u32; }
impl Shape for Pair {
    fn area(&self) -> u32 { self.left }
    fn sides(&self) -> u32 { 2 }
}
=== new src/lib.rs
pub enum Mode { Idle, Busy, Done }
pub struct Pair { pub left: u32, pub right: u8 }
#[derive(PartialEq, PartialOrd)]
pub enum Level { Low, High }
pub fn limit() -> u32 { 10 }
pub fn wide(v: Vec<Vec<u8> >) -> usize { v.len() }
pub fn total(a: bool, b: &bool, v: &[u32]) -> u32 {
    let mut n = 0;
    if a & &*b { n += 1; }
    let s = "a  b";
    n += s.len() as u32;
    for x in v { n += x; }
    n
}
macro_rules! twice { ($e:expr) => { $e * 2 }; }
pub fn double() -> u32 { twice!(limit()) }
pub trait Shape { fn area(&self) -> u32; fn sides(&self) -> u32; }
impl Shape for Pair {
    fn area(&self) -> u32 { self.left }
    fn sides(&self) -> u32 { 2 }
}
