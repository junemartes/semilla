pub fn f(x: u32) -> u32 {
    let a = x.wrapping_add(1);
    let b = a.wrapping_mul(2);
    let c = b.wrapping_add(3);
    let d = c.wrapping_mul(4);
    d.wrapping_add(5)
}
=== new src/lib.rs
pub fn f(x: u32) -> u32 {
    let a = x.wrapping_add(2);
    let b = a.wrapping_mul(3);
    let c = b.wrapping_add(4);
    let d = c.wrapping_mul(5);
    d.wrapping_add(6)
}
