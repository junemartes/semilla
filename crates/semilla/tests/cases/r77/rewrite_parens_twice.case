=== old src/lib.rs
pub fn g(a: u32, b: u32) -> u32 {
    (a + b).min(a + b)
}
=== new src/lib.rs
pub fn g(a: u32, b: u32) -> u32 {
    std::cmp::min(a + b, a + b)
}
