=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub struct Bits { pub items: Vec<u8>, pub lo: u8 }

impl Bits {
    pub fn count(&self) -> usize { self.items.len() }
    pub fn first(&self) -> Option<u32> { self.items.first().map(|x| *x as u32) }
}
=== new src/lib.rs
pub struct Bits { pub items: Vec<u16>, pub lo: i8 }

impl Bits {
    pub fn count(&self) -> usize { self.items.len() }
    pub fn first(&self) -> Option<u32> { self.items.first().map(|x| *x as u32) }
}
