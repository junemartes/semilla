=== old src/lib.rs
struct Inner(u32);
pub struct Outer(pub u32);
pub fn make() -> u32 { Inner(1).0 + Outer(2).0 }
=== new src/lib.rs
struct Inner(u32);
pub struct Outer(pub u32);
pub fn make() -> u32 { Inner(1).0 + Outer(2).0 }
impl std::fmt::Display for Inner {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { write!(f, "{}", self.0) }
}
impl std::fmt::Display for Outer {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { write!(f, "{}", self.0) }
}
