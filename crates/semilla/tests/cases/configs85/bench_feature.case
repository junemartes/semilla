    x + 1
}
=== old benches/probe.rs
pub fn hash(x: u64) -> u64 {
    x.wrapping_mul(31) ^ 7
}

#[test]
fn bench_hash() {
    assert!(hash(1) > 0);
}
=== new benches/probe.rs
pub fn hash(x: u64) -> u64 {
    if x == 0 {
        return 1;
    }
    x.wrapping_mul(31) ^ 7
}

#[test]
fn bench_hash() {
    assert!(hash(1) > 0);
}
=== both tests/probe.rs
pub fn hash(x: u64) -> u64 {
    if x > 10 {
        x + 1
    } else {
        x * 3
    }
}

#[test]
fn test_hash() {
    assert!(hash(2) > 0);
}
