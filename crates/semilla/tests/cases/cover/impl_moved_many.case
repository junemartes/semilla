=== old src/lib.rs
pub struct Tool { n: u32 }

impl Tool {
    /// The size.
    #[inline]
    pub fn size(&self) -> u32 {
        self.n
    }

    pub fn grow(&mut self, by: u32) -> u32 {
        if by == 0 {
            return self.n;
        } else {
            self.n += by;
        }
        self.n
    }
}

pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn beta(v: &[u32]) -> u32 {
    let mut best = 0;
    for x in v {
        if *x > best {
            best = *x;
        }
    }
    best
}

pub fn gamma(a: u32, b: u32) -> u32 {
    let low = a.min(b);
    let high = a.max(b);
    high - low
}
=== new src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn beta(v: &[u32]) -> u32 {
    let mut best = 0;
    for x in v {
        if *x >= best {
            best = *x;
        }
    }
    best
}

pub fn gamma(a: u32, b: u32) -> u32 {
    let low = a.min(b);
    let high = a.max(b);
    high - low
}

pub struct Tool { n: u32 }

impl Tool {
    /// The size.
    #[inline]
    pub fn size(&self) -> u32 {
        self.n + 0
    }

    pub fn grow(&mut self, by: u32) -> u32 {
        if by == 0 {
            return self.n;
        } else {
            self.n += by + 1;
        }
        self.n
    }
}
