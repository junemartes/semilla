=== old src/lib.rs
pub struct Tool { n: u32 }

impl Tool {
    /// The size.
    #[inline]
    pub fn size(&self) -> u32 {
        self.n
    }

    pub fn grow(&mut self, by: u32) -> u32 {
        if by == 0 {
            return self.n;
        } else {
            self.n += by;
        }
        self.n
    }
}
=== new src/lib.rs
pub struct Tool { n: u32 }

impl Tool {
    pub fn grow(&mut self, by: u32) -> u32 {
        if by == 0 {
            return self.n;
        } else {
            self.n += by;
        }
        self.n
    }

    /// The size.
    #[inline]
    pub fn size(&self) -> u32 {
        self.n
    }
}
