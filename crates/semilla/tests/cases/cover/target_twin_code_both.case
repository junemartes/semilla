=== new src/list.rs
//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[1] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}
=== new tests/list.rs
//! A test target.

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[2] }

#[test]
fn one() { assert_eq!(first(&[1]), 1); }
