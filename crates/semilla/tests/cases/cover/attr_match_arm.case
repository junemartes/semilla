//! The crate docs.

pub fn first_item() -> u32 { 0 }

pub fn pick(n: u32) -> u32 {
    match n {
        0 => 1,
        #[cfg(all())]
        1 => 2,
        _ => 3,
    }
}

pub fn last_item() -> u32 { 0 }
