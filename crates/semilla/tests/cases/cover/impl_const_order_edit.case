=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub struct Code(u32);

impl Code {
    /// Codes below this point are OS errors.
    /// The crates use the codes above it.
    pub const INTERNAL_START: u32 = 1 << 31;

    /// Codes at or above this point are for users.
    /// They are custom errors.
    pub const CUSTOM_START: u32 = (1 << 31) + (1 << 30);

    pub fn get(&self) -> u32 { self.0 }
}
=== new src/lib.rs
pub struct Code(u32);

impl Code {
    /// Codes at or above this point are for users.
    /// They are custom errors.
    pub const CUSTOM_START: u32 = (1 << 31) + (1 << 30);

    /// Codes below this point are OS errors.
    /// The crates use the codes above it.
    pub const INTERNAL_START: u32 = 1 << 30;

    pub fn get(&self) -> u32 { self.0 }
}
