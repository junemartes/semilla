=== both src/list.rs
//! Tools for lists.
//! A second line.

// A plain comment.
use std::cmp::max;

/// The first element.
pub fn first(v: &[u32]) -> u32 { v[0] }

/// The larger one.
pub fn larger(a: u32, b: u32) -> u32 {
    let m = max(a, b);
    m
}
=== old src/checks.rs
use crate::list::first;

#[test]
fn one() {
    let v = [1, 2];
    assert_eq!(first(&v), 1);
}

#[test]
fn two() {
    let v = [2, 1];
    assert_eq!(first(&v), 2);
}
