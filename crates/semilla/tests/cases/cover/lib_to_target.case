=== new tests/checks.rs
use depot::list::first;

#[test]
fn one() {
    let v = [1, 2];
    assert_eq!(first(&v), 1);
}

#[test]
fn two() {
    let v = [2, 1];
    assert_eq!(first(&v), 2);
}
