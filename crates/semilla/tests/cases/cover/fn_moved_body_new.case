=== old src/lib.rs
pub fn dirs() -> Vec<u32> { vec![1, 2] }

pub fn helper() -> u32 { 7 }

pub struct Found { pub file: Option<u32>, pub dirs: Vec<u32> }

/// Finds the things.
pub fn probe() -> Found {
    let mut result = Found { file: None, dirs: Vec::new() };
    for dir in dirs() {
        // an old comment
        let names = [1, 2, 3];
        for name in names.iter() {
            if dir == *name {
                result.file = Some(dir);
            }
        }
        result.dirs.push(dir);
    }
    result
}
=== new src/lib.rs
pub fn dirs() -> Vec<u32> { vec![1, 2] }

/// Finds the things.
pub fn probe() -> Found {
    let mut result = Found { file: None, dirs: Vec::new() };
    if result.file.is_none() {
        result.file = Some(0);
    }

    for dir in dirs() {
        let d = dir + 1;
        if d > 1 {
            result.dirs.push(d);
        }
    }

    result
}

pub fn helper() -> u32 { 7 }

pub struct Found { pub file: Option<u32>, pub dirs: Vec<u32> }
