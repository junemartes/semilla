=== old src/lib.rs
pub struct Source;
pub trait Draw<T> { fn sample(&self, seed: u32) -> T; }
pub struct Small(usize);
impl Small { fn new(v: usize) -> Small { Small(v) } }
pub struct Large(usize);
impl Large { fn new(v: usize) -> Large { Large(v) } }

impl Draw<Small> for Source {
    fn sample(&self, seed: u32) -> Small {
        check(seed);
        #[cfg(target_pointer_width = "32")]
        let value = seed as u32 as usize;
        #[cfg(target_pointer_width = "64")]
        let value = seed as u64 as usize;
        #[cfg(not(any(
            target_pointer_width = "32",
            target_pointer_width = "64"
        )))]
        compile_error!("no width");

        Small::new(value)
    }
}
=== new src/lib.rs
pub struct Source;
pub trait Draw<T> { fn sample(&self, seed: u32) -> T; }
pub struct Small(usize);
impl Small { fn new(v: usize) -> Small { Small(v) } }
pub struct Large(usize);
impl Large { fn new(v: usize) -> Large { Large(v) } }

impl Draw<Small> for Source {
    fn sample(&self, seed: u32) -> Small {
        const { assert!(true) };

        #[cfg(target_pointer_width = "32")]
        let value = seed as u32 as usize;
        #[cfg(target_pointer_width = "64")]
        let value = seed as u64 as usize;
        #[cfg(not(any(
            target_pointer_width = "32",
            target_pointer_width = "64"
        )))]
        compile_error!("no width");

        Small::new(value)
    }
}

impl Draw<Large> for Source {
    fn sample(&self, seed: u32) -> Large {
        const { assert!(true) };

        #[cfg(target_pointer_width = "32")]
        let value = seed as u32 as usize;
        #[cfg(target_pointer_width = "64")]
        let value = seed as u64 as usize;
        #[cfg(not(any(
            target_pointer_width = "32",
            target_pointer_width = "64"
        )))]
        compile_error!("no width");

        Large::new(value)
    }
}
