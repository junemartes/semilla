pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

#[test]
fn check() {
    let v = [1, 2, 3];
    assert_eq!(
        v.iter().copied().sum::<u32>(),
        6,
        "the sum"
    );
    assert_eq!(v.len(), 3);
}
