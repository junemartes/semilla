=== old src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn beta(v: &[u32]) -> u32 {
    let mut best = 0;
    for x in v {
        if *x > best {
            best = *x;
        }
    }
    best
}

pub fn gamma(a: u32, b: u32) -> u32 {
    let low = a.min(b);
    let high = a.max(b);
    high - low
}

pub fn delta(a: u32) -> u32 {
    a + 1
}
=== new src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn gamma(a: u32, b: u32) -> u32 {
    let low = a.min(b);
    let high = a.max(b);
    high - low
}

pub fn delta(a: u32) -> u32 {
    a + 1
}

pub fn beta(v: &[u32]) -> u32 {
    let mut best = 0;
    for x in v {
        if *x >= best {
            best = *x;
        }
    }
    best
}
