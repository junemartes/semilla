=== old src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn clear(p: *mut u32, live: &mut bool) {
    unsafe {
        if *live {
            *p = 0;
            *live = false;
        }
    }
}
=== new src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn clear(p: *mut u32, live: &mut bool) {
    if *live {
        // SAFETY: the pointer is valid.
        unsafe { *p = 0 };
        *live = false;
    }
}
