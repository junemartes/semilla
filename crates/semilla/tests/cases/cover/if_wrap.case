=== old src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn total(v: &[u32], live: bool) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n += 1;
    n
}
=== new src/lib.rs
pub fn alpha(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}

pub fn total(v: &[u32], live: bool) -> u32 {
    let mut n = 0;
    if live {
        for x in v {
            n += x;
        }
        n += 1;
    }
    n
}
