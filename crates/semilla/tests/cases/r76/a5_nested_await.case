=== old src/lib.rs
pub async fn get(x: u32) -> u32 {
    x + 1
}

pub async fn total(a: u32) -> u32 {
    get(a).await
}
=== new src/lib.rs
pub async fn get(x: u32) -> u32 {
    x + 1
}

pub async fn total(a: u32) -> u32 {
    get(get(a).await).await
}
