=== old src/lib.rs
pub async fn get(x: u32) -> u32 {
    x + 1
}

pub async fn total(a: u32) -> u32 {
    let v = get(a).await;
    v
}
=== new src/lib.rs
pub async fn get(x: u32) -> u32 {
    x + 1
}

pub async fn total(a: u32) -> u32 {
    let v = get(a).await;
    let w = get(v).await;
    w
}
