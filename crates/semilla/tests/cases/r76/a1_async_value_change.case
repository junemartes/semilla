=== old src/lib.rs
pub async fn get(x: u32) -> u32 {
    x + 1
}

pub async fn total(a: u32) -> u32 {
    let v = get(a).await;
    if v > 3 { v * 2 } else { v }
}
=== new src/lib.rs
pub async fn get(x: u32) -> u32 {
    x + 1
}

pub async fn total(a: u32) -> u32 {
    let v = get(a).await;
    if v > 3 { v * 3 } else { v }
}
