=== old src/lib.rs
pub trait Value {
    fn get(&self) -> u32;
}

macro_rules! make {
    ($n:ident) => {
        struct $n;
        impl crate::Value for $n {
            fn get(&self) -> u32 {
                7
            }
        }
    };
}

pub fn f() -> u32 {
    1
}
=== new src/lib.rs
pub trait Value {
    fn get(&self) -> u32;
}

macro_rules! make {
    ($n:ident) => {
        struct $n;
        impl crate::Value for $n {
            fn get(&self) -> u32 {
                7
            }
        }
    };
}

pub fn f() -> u32 {
    use crate::Value;
    make!(Local);
    Local.get()
}
