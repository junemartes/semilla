=== old src/lib.rs
pub enum Shape {
    Dot(u8),
    Line(u8, u8),
}

pub fn size(s: &Shape) -> u32 {
    match s {
        Shape::Dot(a) => *a as u32,
        Shape::Line(a, b) => *a as u32 + *b as u32,
    }
}
=== new src/lib.rs
pub enum Shape {
    Dot(u16),
    Line(u8, u8),
}

pub fn size(s: &Shape) -> u32 {
    match s {
        Shape::Dot(a) => *a as u32,
        Shape::Line(a, b) => *a as u32 + *b as u32,
    }
}
