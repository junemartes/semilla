=== old src/lib.rs
use std::fmt::Debug;
use std::collections::HashMap;

pub fn show<T: Debug>(value: T) -> String {
    format!("{value:?}")
}

pub fn count(map: &HashMap<u32, u32>) -> usize {
    map.len()
}
=== new src/lib.rs
use std::collections::{BTreeMap, HashMap};
use std::fmt::Debug;

pub fn show<T: Debug>(value: T) -> String {
    format!("{value:?}")
}

pub fn count(map: &HashMap<u32, u32>) -> usize {
    map.len()
}

pub fn size(map: &BTreeMap<u32, u32>) -> usize {
    map.len()
}
