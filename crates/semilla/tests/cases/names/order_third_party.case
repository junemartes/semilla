=== both depot/src/lib.rs
use proc_macro::TokenStream;

#[proc_macro_derive(Rows)]
pub fn rows(input: TokenStream) -> TokenStream {
    // The names of the fields in their order.
    let text = input.to_string();
    let name = text.split_whitespace().skip_while(|word| *word != "struct").nth(1).unwrap_or("X").to_string();
    let fields: Vec<String> = text.split(['{', ',']).skip(1).filter_map(|part| part.split(':').next()).map(|part| part.trim().trim_start_matches("pub ").to_string()).filter(|part| !part.is_empty() && !part.contains('}')).collect();
    format!("impl {name} {{ pub fn rows() -> &'static str {{ {:?} }} }}", fields.join(",")).parse().unwrap()
}
