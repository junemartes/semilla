[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
macro_rules! guard {
    ($v:expr) => { $v > 9 };
}

pub fn check(v: u32) -> u32 {
    if guard!(v) { 1 } else { 0 }
}
=== new src/lib.rs
macro_rules! guard {
    ($v:expr) => { $v > 9 && $v < 90 };
}

pub fn check(v: u32) -> u32 {
    if guard!(v) { 1 } else { 0 }
}
