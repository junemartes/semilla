=== old src/lib.rs
pub fn total(v: &[u32]) -> u32 {
    v.iter().map(|x| x + 1).sum()
}
=== new src/lib.rs
pub fn total(v: &[u32]) -> u32 {
    v.iter().map(|x| if *x > 3 { x + 1 } else { 0 }).sum()
}
