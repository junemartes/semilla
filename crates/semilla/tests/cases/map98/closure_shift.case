=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub fn total(v: &[u32]) -> u32 {
    v.iter().map(|x| x * 2).sum()
}
=== new src/lib.rs
pub fn total(v: &[u32]) -> u32 {
    v.iter().filter(|x| **x > 1).map(|x| if *x > 5 { x * 2 } else { 0 }).sum()
}
