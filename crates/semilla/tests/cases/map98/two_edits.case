=== old src/lib.rs
pub fn fee(a: u32, b: u32) -> u32 {
    let x = if a > 1 { a } else { 1 };
    let y = b * 2;
    x + y
}
=== new src/lib.rs
pub fn fee(a: u32, b: u32) -> u32 {
    let x = if a > 1 { a } else { 1 };
    let y = if b > 5 { b } else { b * 2 };
    x + y
}
