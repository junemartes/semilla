=== old src/lib.rs
pub fn count(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n
}
=== new src/lib.rs
pub fn count(v: &[u32]) -> u32 {
    let mut n = 0;
    for x in v {
        if *x == 0 {
            break;
        }
        n += x;
    }
    n
}
