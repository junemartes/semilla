=== new src/lib.rs
pub fn inc(n: u32) -> u32 {
    n + 1
}

/// Adds two.
pub fn inc2(n: u32) -> u32 {
    #[cfg(unix)]
    let n = n + 1;
    let p = &n as *const u32;
    unsafe { *p + 1 }
}
