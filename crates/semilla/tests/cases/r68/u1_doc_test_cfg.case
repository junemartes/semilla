=== new src/lib.rs
pub fn inc(n: u32) -> u32 {
    n + 1
}

/// Adds two. It is not unsafe.
///
/// ```
/// # #[cfg(feature = "x")]
/// assert_eq!(shop::inc2(1), 3);
/// ```
pub fn inc2(n: u32) -> u32 {
    // #[cfg(feature = "x")] is not here, and no unsafe code is here.
    let _ = "#[cfg(unix)] unsafe";
    n + 2
}
