note: U9: `impl std::ops::Add for X` becomes `impl core::ops::Sub for X`: a different trait, so a removed impl and an added impl
rule-: R70.2-1
must_match: trait impl `<X as std::ops::Add>` removed
must_match: trait impl `<X as core::ops::Sub>` added
=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub struct X(pub u32);

impl std::ops::Add for X {
    type Output = X;
    fn add(self, other: X) -> X {
        X(self.0 + other.0)
    }
}
=== new src/lib.rs
pub struct X(pub u32);

impl core::ops::Sub for X {
    type Output = X;
    fn sub(self, other: X) -> X {
        X(self.0 - other.0)
    }
}
