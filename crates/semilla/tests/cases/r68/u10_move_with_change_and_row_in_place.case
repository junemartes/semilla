=== old src/lib.rs
pub fn f(a: u32, b: u32) -> u32 {
    let p = a + 1;
    let q = b + 2;
    let r = a * b;
    p + q + r
}

pub fn build(out: &mut Vec<(u32, &'static str)>) {
    out.push((1, "one"));
    out.push((2, "two"));
    out.push((3, "three"));
}
=== new src/lib.rs
pub fn f(a: u32, b: u32) -> u32 {
    let q = b + 2;
    let r = a * b;
    let p = a + 2;
    p + q + r
}

pub fn build(out: &mut Vec<(u32, &'static str)>) {
    out.push((1, "one"));
    out.push((2, "deux"));
    out.push((3, "three"));
}
