=== old src/lib.rs
pub fn pick(v: &[u32], i: usize, j: usize) -> u32 {
    let get = |k: usize| v[k];
    get(i).wrapping_add(get(j))
}

pub fn other(v: &[u32], i: usize) -> u32 {
    let get = |k: usize| v[k];
    get(i)
}
=== new src/lib.rs
pub fn pick(v: &[u32], i: usize, j: usize) -> u32 {
    v[i].wrapping_add(v[j])
}

pub fn other(v: &[u32], i: usize) -> u32 {
    let get = |k: usize| v[k];
    get(i).wrapping_add(v[0])
}

pub fn fresh(v: &[u32]) -> u32 {
    let get = |k: usize| v[k];
    get(0).wrapping_add(v[1])
}
