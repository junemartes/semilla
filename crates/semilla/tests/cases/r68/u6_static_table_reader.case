=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
use std::sync::atomic::{AtomicU32, Ordering};
static TABLE: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
static FEES: [u8; 2] = [5, 6];
static COUNT: AtomicU32 = AtomicU32::new(1);

fn look(i: usize) -> u8 {
    TABLE[i & 7]
}

pub fn api(i: usize) -> u8 {
    look(i).wrapping_add(1)
}

pub fn fee(i: usize) -> u8 {
    FEES[i & 1]
}

pub fn count() -> u32 {
    COUNT.load(Ordering::Relaxed)
}
=== new src/lib.rs
use std::sync::atomic::{AtomicU32, Ordering};
static TABLE: [u8; 8] = [1, 2, 9, 4, 5, 6, 7, 8];
static FEES: [u8; 2] = [5, 6];
static COUNT: AtomicU32 = AtomicU32::new(2);

fn look(i: usize) -> u8 {
    TABLE[i & 7]
}

pub fn api(i: usize) -> u8 {
    look(i).wrapping_add(1)
}

pub fn fee(i: usize) -> u8 {
    FEES[i & 1]
}

pub fn count() -> u32 {
    COUNT.load(Ordering::Relaxed)
}
