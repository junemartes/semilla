=== old src/lib.rs
mod a {
    pub(crate) struct Block {
        pub x: u8,
    }

    impl Block {
        pub fn new() -> Block {
            Block { x: 1 }
        }
    }
}

mod b {
    pub struct Block(pub u16);
}

pub use b::Block;

pub fn make() -> u8 {
    a::Block::new().x
}
