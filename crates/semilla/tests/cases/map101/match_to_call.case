=== both .gitignore
/.semilla/
=== old src/lib.rs
pub fn first(r: Result<u32, ()>) -> u32 {
    match r {
        Ok(v) => v,
        Err(_) => unsafe { core::hint::unreachable_unchecked() },
    }
}

pub fn second(r: Result<u8, ()>) -> u8 {
    unsafe {
        match r {
            Ok(v) => v,
            Err(_) => core::hint::unreachable_unchecked(),
        }
    }
}
=== new src/lib.rs
pub fn first(r: Result<u32, ()>) -> u32 {
    unsafe { r.unwrap_unchecked() }
}

pub fn second(r: Result<u8, ()>) -> u8 {
    unsafe { r.unwrap_unchecked() }
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite]
fn ok_or_unreachable<T, E>() {
    (
        |r: Result<T, E>| match r {
            Ok(v) => v,
            Err(_) => unsafe { core::hint::unreachable_unchecked() },
        },
        |r: Result<T, E>| unsafe { r.unwrap_unchecked() },
    )
}
