use semilla_intent::prelude::*;

#[rewrite]
fn ok_or_unreachable<T, E>() {
    (
        |r: Result<T, E>| match r {
            Ok(v) => v,
            Err(_) => unsafe { core::hint::unreachable_unchecked() },
        },
        |r: Result<T, E>| unsafe { r.unwrap_unchecked() },
    )
}
