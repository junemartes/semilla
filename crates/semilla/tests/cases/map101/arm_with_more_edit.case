=== old src/lib.rs
pub fn first(r: Result<u32, ()>, log: &mut u32) -> u32 {
    match r {
        Ok(v) => v,
        Err(_) => {
            *log += 1;
            unsafe { core::hint::unreachable_unchecked() }
        }
    }
}
=== new src/lib.rs
pub fn first(r: Result<u32, ()>, log: &mut u32) -> u32 {
    let _ = log;
    unsafe { r.unwrap_unchecked() }
}
