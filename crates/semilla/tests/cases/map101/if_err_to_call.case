=== old src/lib.rs
pub fn check(r: Result<(), u8>) {
    if r.is_err() {
        unsafe { core::hint::unreachable_unchecked() }
    }
}
=== new src/lib.rs
pub fn check(r: Result<(), u8>) {
    let result = r;
    unsafe { result.unwrap_unchecked() };
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite]
fn err_is_unreachable<T, E>() {
    (
        |r: Result<T, E>| {
            if r.is_err() {
                unsafe { core::hint::unreachable_unchecked() }
            }
        },
        |r: Result<T, E>| {
            unsafe { r.unwrap_unchecked() };
        },
    )
}
