=== old src/lib.rs
pub fn next(o: Option<(u32, u32)>) -> u32 {
    let (a, b) = match o {
        Some(pair) => pair,
        None => unsafe { core::hint::unreachable_unchecked() },
    };
    a + b
}
=== new src/lib.rs
pub fn next(o: Option<(u32, u32)>) -> u32 {
    let (a, b) = {
        let option = o;
        unsafe { option.unwrap_unchecked() }
    };
    a + b
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite]
fn some_or_unreachable<T>() {
    (
        |o: Option<T>| match o {
            Some(v) => v,
            None => unsafe { core::hint::unreachable_unchecked() },
        },
        |o: Option<T>| unsafe { o.unwrap_unchecked() },
    )
}
