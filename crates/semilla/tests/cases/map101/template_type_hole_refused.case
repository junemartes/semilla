=== old src/lib.rs
pub struct Wrap<T: Copy>(pub T, pub u32, pub u32);

pub fn first<T: Copy>(w: &Wrap<T>) -> u32 {
    w.1 + 1
}

pub fn second<T: Copy>(v: &Wrap<T>) -> u32 {
    v.1 * 2
}
=== new src/lib.rs
pub struct Wrap<T: Copy>(pub T, pub u32, pub u32);

pub fn first<T: Copy>(w: &Wrap<T>) -> u32 {
    w.2 + 1
}

pub fn second<T: Copy>(v: &Wrap<T>) -> u32 {
    v.2 * 2
}
