=== old src/lib.rs
#[derive(Clone)]
pub struct Item(pub u32);
#[derive(Clone)]
pub struct Other(pub u8);

pub fn a(x: &Item) -> Item {
    x.clone()
}

pub fn b(x: &Other) -> Other {
    x.clone()
}
=== new src/lib.rs
#[derive(Clone)]
pub struct Item(pub u32);
#[derive(Clone)]
pub struct Other(pub u8);

pub fn a(x: &Item) -> Item {
    x.to_owned()
}

pub fn b(x: &Other) -> Other {
    x.to_owned()
}
