=== both .gitignore
/.semilla/
=== old src/lib.rs
pub fn first(r: Result<u32, ()>, n: u32) -> u32 {
    let v = match r {
        Ok(v) => v,
        Err(_) => unsafe { core::hint::unreachable_unchecked() },
    };
    v + n
}
=== new src/lib.rs
pub fn first(r: Result<u32, ()>, n: u32) -> u32 {
    let v = unsafe { r.unwrap_unchecked() };
    v * n
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite]
fn ok_or_unreachable<T, E>() {
    (
        |r: Result<T, E>| match r {
            Ok(v) => v,
            Err(_) => unsafe { core::hint::unreachable_unchecked() },
        },
        |r: Result<T, E>| unsafe { r.unwrap_unchecked() },
    )
}
