=== old src/lib.rs
pub fn size(o: Option<u32>) -> u32 {
    let n = match o { Some(v) => v, None => 0 };
    n + 1
}
=== new src/lib.rs
pub fn size(o: Option<u32>) -> u32 {
    let n = o.unwrap_or(0);
    n + 1
}
