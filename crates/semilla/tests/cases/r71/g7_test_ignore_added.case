pub fn add(a: u32) -> u32 {
    a + 1
}

#[cfg(test)]
mod tests {
    #[test]
    fn one() {
        assert_eq!(super::add(1), 2);
    }

    #[test]
    fn two() {
        assert_eq!(super::add(2), 3);
    }
}
