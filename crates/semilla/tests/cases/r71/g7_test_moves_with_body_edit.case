pub fn add(a: u32) -> u32 {
    // a comment
    a + 1
}

#[cfg(test)]
mod tests {
    #[test]
    fn one() {
        assert_eq!(super::add(1), 2);
    }

    #[test]
    fn two() {
        let x = 2;
        assert_eq!(super::add(x), 3);
    }
}
