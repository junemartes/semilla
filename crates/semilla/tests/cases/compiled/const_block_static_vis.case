=== old src/lib.rs
const ON: bool = true;
const N: i32 = 7;

static T: usize = {
    let d = [0u8; if ON {
        N as usize
    } else {
        1
    }];
    d.len()
};

pub fn width() -> usize {
    T
}
=== new src/lib.rs
const ON: bool = true;
const N: i32 = 7;

/// The width of the table.
pub(crate) static T: usize = {
    let d = [0u8; if ON {
        N as usize
    } else {
        1
    }];
    d.len()
};

pub fn width() -> usize {
    T
}
