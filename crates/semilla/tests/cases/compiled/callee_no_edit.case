pub trait Tax { fn rate(&self) -> u32; }
pub struct Food;
pub struct Fuel;
impl Tax for Food { fn rate(&self) -> u32 { 5 } }
impl Tax for Fuel { fn rate(&self) -> u32 { 20 } }

pub fn make() -> Fuel { Fuel }

pub fn total() -> u32 { make().rate() }
