=== old src/lib.rs
extern "C" {
    fn log_a(x: u32);
    fn log_b(x: u32);
}

pub fn both(x: u32) {
    unsafe {
        log_a(x);
        log_b(x);
    }
}
=== new src/lib.rs
extern "C" {
    fn log_a(x: u32);
    fn log_b(x: u32);
}

pub fn both(x: u32) {
    unsafe {
        log_b(x);
        log_a(x);
    }
}
