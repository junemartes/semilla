=== old src/lib.rs
pub fn lo(a: u32, b: u32) -> u32 {
    a.min(b)
}

pub fn hi(a: u32, b: u32) -> u32 {
    a.max(b)
}

pub fn sat(a: u32, b: u32) -> u32 {
    a.saturating_add(b)
}

pub fn sat_sub(a: u32, b: u32) -> u32 {
    a.saturating_sub(b)
}

pub fn chk(a: u32, b: u32) -> Option<u32> {
    a.checked_add(b)
}

pub fn wrap(a: u32, b: u32) -> u32 {
    a.wrapping_sub(b)
}

pub fn diff(a: u32, b: u32) -> u32 {
    a.abs_diff(b)
}

pub fn fit(a: u32) -> u32 {
    a.clamp(10, 20)
}

pub fn has(o: Option<u32>) -> bool {
    o.is_some()
}

pub fn or_zero(o: Option<u32>) -> u32 {
    o.unwrap_or(0)
}
=== new src/lib.rs
pub fn lo(a: u32, b: u32) -> u32 {
    if a <= b { a } else { b }
}

pub fn hi(a: u32, b: u32) -> u32 {
    if a >= b { a } else { b }
}

pub fn sat(a: u32, b: u32) -> u32 {
    match a.checked_add(b) { Some(v) => v, None => u32::MAX }
}

pub fn sat_sub(a: u32, b: u32) -> u32 {
    if a > b { a - b } else { 0 }
}

pub fn chk(a: u32, b: u32) -> Option<u32> {
    let (v, o) = a.overflowing_add(b);
    if o { None } else { Some(v) }
}

pub fn wrap(a: u32, b: u32) -> u32 {
    a.wrapping_add(b.wrapping_neg())
}

pub fn diff(a: u32, b: u32) -> u32 {
    if a > b { a - b } else { b - a }
}

pub fn fit(a: u32) -> u32 {
    if a < 10 { 10 } else if a > 20 { 20 } else { a }
}

pub fn has(o: Option<u32>) -> bool {
    !o.is_none()
}

pub fn or_zero(o: Option<u32>) -> u32 {
    match o { Some(v) => v, None => 0 }
}
