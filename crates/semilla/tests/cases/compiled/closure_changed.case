=== old src/lib.rs
pub fn grow(v: &[u32]) -> u32 {
    v.iter().map(|x| x.wrapping_add(1)).sum()
}
=== new src/lib.rs
pub fn grow(v: &[u32]) -> u32 {
    let k: u32 = v.iter().map(|x| x.wrapping_mul(3)).sum();
    v.iter().map(|x| if *x > k { 0 } else { x.wrapping_add(k) }).sum()
}
