=== old src/lib.rs
pub fn price(q: u32) -> u32 {
    q ^ 3
}

pub fn cost(q: u32) -> u32 {
    q ^ 4
}

pub fn total(q: u32) -> u32 {
    let t = price(q);
    t
}
