[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
macro_rules! calc {
    (add $a:expr, $b:expr) => { $a + $b };
    (sub $a:expr, $b:expr) => { $a - $b };
}

pub fn f(a: u32, b: u32) -> u32 { calc!(add a, b) }
pub fn g(a: u32, b: u32) -> u32 { calc!(sub a, b) }
=== new src/lib.rs
macro_rules! calc {
    (add $a:expr, $b:expr) => { $a * $b };
    (sub $a:expr, $b:expr) => { $a - $b };
}

pub fn f(a: u32, b: u32) -> u32 { calc!(add a, b) }
pub fn g(a: u32, b: u32) -> u32 { calc!(sub a, b) }
