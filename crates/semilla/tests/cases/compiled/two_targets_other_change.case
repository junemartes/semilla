    1
}

pub fn price(x: u32) -> u32 {
    x + 1
}
=== new src/lib.rs
#[cfg(feature = "fast")]
pub fn speed() -> u32 {
    2
}

#[cfg(not(feature = "fast"))]
pub fn speed() -> u32 {
    1
}

#[cfg(feature = "small")]
