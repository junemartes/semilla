=== both depot_macros/src/lib.rs
use proc_macro::TokenStream;

#[proc_macro_attribute]
pub fn helper(_attr: TokenStream, item: TokenStream) -> TokenStream {
    // The item again from its text: each token has the span of the call.
    let text = format!("macro_rules! __helper_9f3a {{ () => {{ 0 }} }} {item}");
    text.parse().unwrap()
}
=== both shop/Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"

[dependencies]
depot_macros = { path = "../depot_macros" }
=== old shop/src/lib.rs
pub struct Cart {
    pub sum: u32,
}

#[depot_macros::helper]
impl Cart {
    pub fn total(&self) -> u32 {
        self.sum + 1
    }

    pub fn half(&self) -> u32 {
        self.sum / 2
    }

    pub fn double(&self) -> u32 {
        self.sum * 2
    }
}
=== new shop/src/lib.rs
pub struct Cart {
    pub sum: u32,
}

#[depot_macros::helper]
impl Cart {
    pub fn total(&self) -> u32 {
        self.sum + 2
    }

    pub fn half(&self) -> u32 {
        self.sum / 3
    }

    pub fn double(&self) -> u32 {
        self.sum * 4
    }
}
