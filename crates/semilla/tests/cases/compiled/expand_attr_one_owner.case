=== old shop/src/lib.rs
pub struct Cart {
    pub sum: u32,
}

#[depot_macros::helper]
impl Cart {
    pub fn total(&self) -> u32 {
        self.sum + 1
    }

    pub fn half(&self) -> u32 {
        self.sum / 2
    }

    pub fn double(&self) -> u32 {
        self.sum * 2
    }
}
=== new shop/src/lib.rs
pub struct Cart {
    pub sum: u32,
}

#[depot_macros::helper]
impl Cart {
    pub fn total(&self) -> u32 {
        self.sum + 2
    }

    pub fn half(&self) -> u32 {
        self.sum / 3
    }

    pub fn double(&self) -> u32 {
        self.sum * 4
    }
}
