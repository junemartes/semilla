=== old src/lib.rs
pub fn find(v: &[u32]) -> usize {
    let mut i = 0;
    loop {
        if v[i] == 7 {
            break;
        }
        i += 1;
    }
    i
}
=== new src/lib.rs
pub fn find(v: &[u32]) -> usize {
    let mut i = 0;
    loop {
        if v[i] == 7 {
            break;
        }
        if v[i] == 9 {
            break;
        }
        i += 1;
    }
    i
}
