=== old src/lib.rs
pub fn last(n: u32) -> u32 {
    let mut i = 0;
    let mut seen: u32 = 0;
    while i < n {
        seen = i;
        i += 1;
    }
    seen
}
=== new src/lib.rs
pub fn last(n: u32) -> u32 {
    let mut i = 0;
    let mut seen: u32 = 0;
    while i < n {
        i += 1;
        seen = i;
    }
    seen
}
