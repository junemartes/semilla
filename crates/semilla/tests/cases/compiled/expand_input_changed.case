=== old src/lib.rs
macro_rules! scale { ($v:expr) => { $v * 3 } }
macro_rules! other { ($v:expr) => { $v + 1 } }

pub fn f(v: u32) -> u32 { scale!(v + 1) }
pub fn g(v: u32) -> u32 { other!(v) }
