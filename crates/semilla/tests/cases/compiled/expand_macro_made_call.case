=== old src/lib.rs
macro_rules! make {
    ($name:ident, $d:tt) => {
        macro_rules! $name {
            ($d($d x:expr),*) => { make!{@inner $name ($d) => ( $d($d x),* ) } };
        }
    };
    (@inner $name:ident ($d:tt) => ( $($e:expr),* )) => { 0 $(+ $e)* };
}

make!(sum, $);

pub fn total() -> u32 { sum!(1, 2) }
=== new src/lib.rs
macro_rules! make {
    ($name:ident, $d:tt) => {
        macro_rules! $name {
            ($d($d x:expr),*) => { make!{@inner $name ($d) => ( $d($d x),* ) } };
        }
    };
    (@inner $name:ident ($d:tt) => ( $($e:expr),* )) => { 1 $(* $e)* };
}

make!(sum, $);

pub fn total() -> u32 { sum!(1, 2) }
