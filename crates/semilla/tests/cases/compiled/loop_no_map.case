=== old src/lib.rs
pub fn steps(n: u32) -> u32 {
    let mut i: u32 = 0;
    let mut k: u32 = 0;
    while i < n {
        k = k.wrapping_add(2);
        i += 1;
    }
    k
}
=== new src/lib.rs
pub fn steps(n: u32) -> u32 {
    let mut left: u32 = n;
    let mut k: u32 = 0;
    while left > 0 {
        k = k.wrapping_add(2);
        left -= 1;
    }
    k
}
