=== both src/lib.rs
macro_rules! table {
    ($name:literal) => {{
        const DATA: &[u8] = include_bytes!(concat!("../data/", $name, ".txt"));
        DATA.len()
    }};
}

pub fn size() -> usize {
    table!("a")
}
