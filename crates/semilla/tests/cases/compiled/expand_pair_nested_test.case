=== old src/lib.rs
macro_rules! bump { ($v:expr) => { $v + 1 } }

pub fn pick(v: u32) -> u32 { bump!(v) }
pub fn keep(v: u32) -> u32 { v }
pub fn base(v: u32) -> u32 { bump!(v) }
=== new src/lib.rs
macro_rules! bump { ($v:expr) => { $v + 2 } }

pub fn pick(v: u32) -> u32 { v }
pub fn keep(v: u32) -> u32 { bump!(v) }
pub fn base(v: u32) -> u32 { bump!(v) }
=== both tests/sets.rs
macro_rules! set {
    ($($v:expr),*) => { vec![$($v),*] };
}

macro_rules! one_of {
    ($x:expr, [$($s:expr),*]) => { [$($s),*].iter().any(|s: &Vec<u32>| s.contains(&$x)) };
}

#[test]
fn sets() {
    let x = shop::pick(1);
    assert!(one_of!(x, [set![0, 1], set![1, 2]]));
    assert!(one_of!(x, [set![2, 3], set![3, 4]]));
}
=== both examples/sets.rs
macro_rules! set {
    ($($v:expr),*) => { vec![$($v),*] };
}

macro_rules! one_of {
    ($x:expr, [$($s:expr),*]) => { [$($s),*].iter().any(|s: &Vec<u32>| s.contains(&$x)) };
}

fn main() {
    let x = shop::pick(1);
    println!("{}", one_of!(x, [set![0, 1], set![1, 2]]));
    println!("{}", one_of!(x, [set![5, 6], set![7]]));
}
=== both benches/sets.rs
macro_rules! set {
    ($($v:expr),*) => { vec![$($v),*] };
}

macro_rules! one_of {
    ($x:expr, [$($s:expr),*]) => { [$($s),*].iter().any(|s: &Vec<u32>| s.contains(&$x)) };
}

fn main() {
    let x = shop::pick(1);
    println!("{}", one_of!(x, [set![0, 1], set![1, 2]]));
    println!("{}", one_of!(x, [set![8], set![9, 10]]));
}
