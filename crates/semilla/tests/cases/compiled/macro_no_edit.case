=== old src/lib.rs
macro_rules! guard {
    ($v:expr) => {
        if $v > 9 {
            return 0;
        }
    };
}

pub fn limit(v: u32) -> u32 {
    guard!(v);
    v
}
=== new src/lib.rs
macro_rules! guard {
    ($v:expr) => {
        if $v > 9 {
            return 0;
        }
        if $v == 5 {
            return 5;
        }
    };
}

pub fn limit(v: u32) -> u32 {
    guard!(v);
    v
}
