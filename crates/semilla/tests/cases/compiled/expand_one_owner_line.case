=== old src/lib.rs
pub struct Meters(pub u32);

impl From<u32> for Meters {
    fn from(v: u32) -> Self { Meters(v) }
}

macro_rules! check_here {
    ($e:expr) => {
        if !$e { panic!(concat!("failed at ", file!(), ":", line!())) }
    };
}

#[test]
fn one() {
    let m: Meters = 3.into();
    check_here!(m.0 == 3);
}

#[test]
fn two() {
    let m = Meters::from(4);
    check_here!(m.0 == 4);
    check_here!(m.0 > 1);
}
=== new src/lib.rs
pub struct Meters(pub u64);

impl From<u64> for Meters {
    fn from(v: u64) -> Self {
        Meters(v)
    }
}

macro_rules! check_here {
    ($e:expr) => {
        if !$e { panic!(concat!("failed at ", file!(), ":", line!())) }
    };
}

#[test]
fn one() {
    let m: Meters = 3.into();
    check_here!(m.0 == 3);
}

#[test]
fn two() {
    let m = Meters::from(4);
    check_here!(m.0 == 4);
    check_here!(m.0 > 1);
}
