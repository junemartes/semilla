=== old src/lib.rs
pub fn count(n: u32) -> u32 {
    let mut i: u32 = 0;
    let mut hits: u32 = 0;
    while i < n {
        if i % 3 == 0 {
            hits = hits.wrapping_add(1);
        }
        i = i.wrapping_add(1);
    }
    hits
}
=== new src/lib.rs
pub fn count(n: u32) -> u32 {
    let mut i: u32 = 0;
    let mut hits: u32 = 0;
    loop {
        if i >= n {
            break;
        }
        if i % 3 == 0 {
            hits = hits.wrapping_add(1);
        }
        i = i.wrapping_add(1);
    }
    hits
}
