=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }

#[derive(Default)]
pub struct Food;
#[derive(Default)]
pub struct Fuel;

impl Tax for Food { fn rate(&self) -> u32 { 5 } }
impl Tax for Fuel { fn rate(&self) -> u32 { 20 } }

pub fn charge<T: Tax>(t: &T, n: u32) -> u32 { t.rate().wrapping_mul(n) }

pub type Item = Food;

pub fn bill(n: u32) -> u32 { charge(&Item::default(), n) }
=== new src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }

#[derive(Default)]
pub struct Food;
#[derive(Default)]
pub struct Fuel;

impl Tax for Food { fn rate(&self) -> u32 { 5 } }
impl Tax for Fuel { fn rate(&self) -> u32 { 20 } }

pub fn charge<T: Tax>(t: &T, n: u32) -> u32 { t.rate().wrapping_mul(n) }

pub type Item = Fuel;

pub fn bill(n: u32) -> u32 { charge(&Item::default(), n) }
