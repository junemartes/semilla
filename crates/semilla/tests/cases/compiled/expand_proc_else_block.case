=== both depot/src/lib.rs
use proc_macro::{Delimiter, Group, TokenStream, TokenTree};

/// Makes a method `level`: an `if` whose condition has the literal of the attribute
/// `#[level(N)]` (a token of the input) and whose `else` block has only made tokens.
#[proc_macro_derive(Level, attributes(level))]
pub fn level(input: TokenStream) -> TokenStream {
    let mut name = String::new();
    let mut limit = None;
    let mut next = false;
    for token in input {
        match token {
            TokenTree::Group(group) if group.delimiter() == Delimiter::Bracket => {
                for inner in group.stream() {
                    if let TokenTree::Group(args) = inner {
                        limit = args.stream().into_iter().next();
                    }
                }
            }
            TokenTree::Ident(ident) if next => {
                name = ident.to_string();
                break;
            }
            TokenTree::Ident(ident) => next = ident.to_string() == "struct",
            _ => {}
        }
    }
    let mut body: TokenStream = "if x >".parse().unwrap();
    body.extend(limit);
    body.extend("{ x } else { 0 }".parse::<TokenStream>().unwrap());
    let mut inner: TokenStream = "pub fn level(&self, x: u32) -> u32".parse().unwrap();
    inner.extend([TokenTree::Group(Group::new(Delimiter::Brace, body))]);
    let mut out: TokenStream = format!("impl {name}").parse().unwrap();
    out.extend([TokenTree::Group(Group::new(Delimiter::Brace, inner))]);
    out
}

/// Makes the literal `1` in 1001 pairs of parentheses: a tree deeper than the limit of the
/// printer of the driver.
#[proc_macro]
pub fn deep(_input: TokenStream) -> TokenStream {
    let mut out: TokenStream = "1".parse().unwrap();
    for _ in 0..1001 {
        out = TokenStream::from(TokenTree::Group(Group::new(Delimiter::Parenthesis, out)));
    }
    out
}
