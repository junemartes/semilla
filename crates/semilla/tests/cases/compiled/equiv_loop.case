=== old src/lib.rs
pub fn sum(n: u32) -> u32 {
    let mut s = 0u32;
    let mut i = 0;
    while i < n { s = s.wrapping_add(i); i += 1; }
    s
}
=== new src/lib.rs
pub fn sum(n: u32) -> u32 {
    let mut s = 0u32;
    let mut i = 0;
    while i < n { s = s.wrapping_add(i * 1); i += 1; }
    s
}
