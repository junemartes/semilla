=== old src/lib.rs
pub enum Shape {
    Dot,
    Line,
    Box,
}

pub fn cost(s: &Shape) -> u32 {
    match s {
        Shape::Dot => 1,
        _ => cost_of(2),
    }
}

fn cost_of(v: u32) -> u32 {
    v
}
=== new src/lib.rs
pub enum Shape {
    Dot,
    Line,
    Box,
}

pub fn cost(s: &Shape) -> u32 {
    match s {
        Shape::Dot => 1,
        Shape::Line => cost_of(3),
        _ => cost_of(2),
    }
}

fn cost_of(v: u32) -> u32 {
    v
}
