=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub fn tier(k: u8) -> u32 {
    match k {
        0 => 2,
        1 => 4,
        _ => 8,
    }
}

pub fn cost(k: u8, n: u32) -> u32 {
    let t = tier(k);
    n * t
}
=== new src/lib.rs
pub fn tier(k: u8) -> u32 {
    match k {
        0 => 2,
        1 => 5,
        _ => 8,
    }
}

pub fn cost(k: u8, n: u32) -> u32 {
    n * tier(k)
}
