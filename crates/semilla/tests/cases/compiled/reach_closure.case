=== old src/lib.rs
pub fn big(v: &[u32]) -> bool {
    v.iter().any(|x| *x > 9)
}

pub fn report(v: &[u32]) -> u32 {
    if big(v) { 1 } else { 0 }
}
=== new src/lib.rs
pub fn big(v: &[u32]) -> bool {
    v.iter().any(|x| *x >= 9)
}

pub fn report(v: &[u32]) -> u32 {
    if big(v) { 1 } else { 0 }
}
