=== old src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }
pub struct Food;
impl Tax for Food { fn rate(&self) -> u32 { 5 } }

pub fn price() -> u32 {
    let item = Food;
    item.rate()
}
