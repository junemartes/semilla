pub fn acc_a(n: u32, c: bool) -> u32 {
    let mut i: u32 = 0;
    let mut sum: u32 = if c { 0 } else { 6 };
    while i < n {
        sum = sum.wrapping_add(i);
        i += 1;
    }
    sum
}

pub fn acc_b(n: u32, c: bool) -> u32 {
    let mut i: u32 = 0;
    let mut sum: u32 = if c { 6 } else { 0 };
    while i < n {
        sum = sum.wrapping_add(i);
        i += 1;
    }
    sum
}
