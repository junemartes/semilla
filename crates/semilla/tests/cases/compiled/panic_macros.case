pub fn a(x: u32) -> u32 { if x > 9 { panic!("too big"); } x ^ 1 }
pub fn b(x: u32, y: u32) -> u32 { assert_eq!(x, y); x ^ y }
pub fn c(x: u32) -> u32 { if x > 9 { unreachable!() } x ^ 3 }
pub fn d(x: u32) -> u32 { if x > 9 { todo!() } x ^ 4 }
