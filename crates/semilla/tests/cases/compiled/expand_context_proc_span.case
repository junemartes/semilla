=== both depot/src/lib.rs
use proc_macro::{Delimiter, Group, Literal, Punct, Spacing, Span, TokenStream, TokenTree};

#[proc_macro]
pub fn here(input: TokenStream) -> TokenStream {
    // The tokens of the input keep their spans; the line is a token that the macro makes.
    let line = Span::call_site().line() as u32;
    let mut inner = input;
    inner.extend([TokenTree::Punct(Punct::new(',', Spacing::Alone)), TokenTree::Literal(Literal::u32_suffixed(line))]);
    TokenStream::from(TokenTree::Group(Group::new(Delimiter::Parenthesis, inner)))
}
