=== old src/lib.rs
pub struct Grid<T>(pub T);

impl<T> Grid<T> {
    pub const ROWS: usize = 2 * core::mem::size_of::<T>();
    pub const CELLS: usize = 4 * core::mem::size_of::<T>();
}

pub fn rows<T>(x: usize) -> usize {
    x.wrapping_add(Grid::<T>::ROWS)
}

pub fn cells<T>(x: usize) -> usize {
    x.wrapping_add(Grid::<T>::CELLS)
}
=== new src/lib.rs
pub struct Grid<T>(pub T);

impl<T> Grid<T> {
    pub const ROWS: usize = 3 * core::mem::size_of::<T>();
    pub const CELLS: usize = 4 * core::mem::size_of::<T>();
}

pub fn rows<T>(x: usize) -> usize {
    x.wrapping_add(Grid::<T>::ROWS)
}

pub fn cells<T>(x: usize) -> usize {
    x.wrapping_add(Grid::<T>::CELLS)
}
