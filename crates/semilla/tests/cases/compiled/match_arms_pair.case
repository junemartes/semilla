=== old src/lib.rs
pub enum Shape { Dot, Line, Box, Ring }

pub fn cost_of(n: u32) -> u32 { n ^ 7 }

pub fn cost(s: Shape) -> u32 {
    match s {
        Shape::Dot => cost_of(1),
        Shape::Line => cost_of(2),
        _ => 0,
    }
}
=== new src/lib.rs
pub enum Shape { Dot, Line, Box, Ring }

pub fn cost_of(n: u32) -> u32 { n ^ 7 }

pub fn cost(s: Shape) -> u32 {
    match s {
        Shape::Box => cost_of(9),
        Shape::Dot => cost_of(1),
        Shape::Line => cost_of(3),
        _ => 0,
    }
}
