=== old src/lib.rs
pub fn sum_to(n: u32) -> u32 {
    let mut sum: u32 = 0;
    for i in 0..n {
        sum = sum.wrapping_add(i);
    }
    sum
}
=== new src/lib.rs
pub fn sum_to(n: u32) -> u32 {
    let mut sum: u32 = 0;
    for i in 0..n {
        sum = i.wrapping_add(sum);
    }
    sum
}
