pub fn tier(k: u8) -> u32 {
    match k {
        0 => 2,
        1 => 5,
        _ => 8,
    }
}

pub fn c1(k: u8) -> u32 { tier(k).wrapping_add(1) }
pub fn c2(k: u8) -> u32 { c1(k).wrapping_add(1) }
pub fn c3(k: u8) -> u32 { c2(k).wrapping_add(1) }
pub fn c4(k: u8) -> u32 { c3(k).wrapping_add(1) }
pub fn c5(k: u8) -> u32 { c4(k).wrapping_add(1) }
pub fn c6(k: u8) -> u32 { c5(k).wrapping_add(1) }
