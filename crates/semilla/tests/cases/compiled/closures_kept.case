=== old src/lib.rs
pub fn keep(v: &[u32]) -> u32 {
    let a: u32 = v.iter().map(|x| x.wrapping_add(1)).sum();
    let b: u32 = v.iter().map(|x| x.wrapping_mul(2)).sum();
    a ^ b
}
=== new src/lib.rs
pub fn keep(v: &[u32]) -> u32 {
    let a: u32 = v.iter().map(|x| x.wrapping_add(1)).sum();
    let b: u32 = v.iter().map(|x| x.wrapping_mul(2)).sum();
    a | b
}
