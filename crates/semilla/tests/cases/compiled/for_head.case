=== old src/lib.rs
pub fn sum(v: &[u32]) -> u32 {
    let mut s = 0;
    for x in v.iter() {
        s ^= *x;
    }
    s
}
=== new src/lib.rs
pub fn sum(v: &[u32]) -> u32 {
    let mut s = 0;
    for x in v.iter().rev() {
        s ^= *x;
    }
    s
}
