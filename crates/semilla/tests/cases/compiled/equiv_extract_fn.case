=== old src/lib.rs
pub fn cost(w: u32) -> u32 {
    let base = if w > 10 { 15 } else { 5 };
    base + 1
}
=== new src/lib.rs
fn ship(w: u32) -> u32 {
    if w > 10 { 15 } else { 5 }
}

pub fn cost(w: u32) -> u32 {
    let base = ship(w);
    base + 1
}
