=== both src/lib.rs
pub fn size(text: &[u8]) -> usize {
    text.len()
}
=== both tests/lib.rs
fn suite() -> usize {
    let mut total = 0;
    macro_rules! load {
        ($name:literal) => {{
            const DATA: &[u8] = include_bytes!(concat!("../testdata/", $name, ".txt"));
            total += lexer::size(DATA);
        }};
    }
    load!("anchored");
    load!("regression");
    total
}

#[test]
fn plain() {
    assert!(suite() > 0);
}
