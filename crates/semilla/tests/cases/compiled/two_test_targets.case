=== both lexer-core/src/lib.rs
pub fn count(text: &[u8]) -> usize {
    text.iter().filter(|b| **b == b'\n').count()
}
=== both lexer-core/tests/lib.rs
fn suite() -> usize {
    let mut total = 0;
    macro_rules! load {
        ($name:literal) => {{
            const DATA: &[u8] = include_bytes!(concat!("../../testdata/", $name, ".txt"));
            total += lexer_core::count(DATA);
        }};
    }
    load!("anchored");
    load!("regression");
    total
}

#[test]
fn regression() {
    assert!(suite() > 0);
}
