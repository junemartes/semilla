=== old src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }
pub struct Food;
impl Tax for Food { fn rate(&self) -> u32 { 5 } }

pub fn rated<T: Tax>(t: &T) -> u32 {
    t.rate() ^ 1
}
=== new src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }
pub struct Food;
impl Tax for Food { fn rate(&self) -> u32 { 6 } }

pub fn rated<T: Tax>(t: &T) -> u32 {
    t.rate() ^ 2
}
