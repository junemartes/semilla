=== old src/lib.rs
pub fn price(q: u32) -> u32 {
    q * 3
}

pub fn order(q: u32) -> Option<u32> {
    let total = price(q);
    Some(total)
}
=== new src/lib.rs
pub fn price(q: u32) -> u32 {
    q * 3
}

pub fn order(q: u32) -> Option<u32> {
    if q == 0 {
        return None;
    }
    let total = price(q);
    Some(total)
}
