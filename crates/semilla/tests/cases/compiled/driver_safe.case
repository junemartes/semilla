=== old src/lib.rs
use std::future::Future;

pub trait Speak {
    fn speak(&self) -> u32 {
        1
    }
    fn loud(&self) -> u32 {
        self.speak() + 1
    }
}

pub struct Dog;

impl Speak for Dog {}

pub trait Make {
    type Out;
    fn make(&self) -> Self::Out;
}

impl Make for Dog {
    type Out = u32;
    fn make(&self) -> u32 {
        3
    }
}

pub struct Wrap<T: Make> {
    pub inner: Option<<T as Make>::Out>,
    pub base: T,
}

pub struct Pair<T>(pub T, pub T);

impl<T: Copy> Iterator for Pair<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(self.0)
    }
}

pub fn talk(s: &dyn Speak) -> u32 {
    s.loud() + 1
}

pub fn bits(x: u32) -> u32 {
    x.count_ones() + 1
}

pub fn copy_one(a: &[u8; 4], b: &mut [u8; 4]) -> u8 {
    unsafe { std::ptr::copy(a.as_ptr(), b.as_mut_ptr(), 1) }
    b[0] + 1 as u8
}

pub fn first<I: Iterator>(mut it: I) -> (Option<I::Item>, u32) {
    (it.next(), 1)
}

pub fn wrap<T: Make>(base: T) -> (Wrap<T>, u32) {
    let inner = Some(base.make());
    (Wrap { inner, base }, 1)
}

pub fn use_all() -> u32 {
    let (w, k) = wrap(Dog);
    first(Pair(1u32, 2)).0.unwrap_or(0) + w.inner.unwrap_or(0) + talk(&Dog) + k
}

pub async fn later(x: u32) -> u32 {
    x + 1
}

pub fn run_later() -> impl Future<Output = u32> {
    later(1)
}
=== new src/lib.rs
use std::future::Future;

pub trait Speak {
    fn speak(&self) -> u32 {
        1
    }
    fn loud(&self) -> u32 {
        self.speak() + 1
    }
}

pub struct Dog;

impl Speak for Dog {}

pub trait Make {
    type Out;
    fn make(&self) -> Self::Out;
}

impl Make for Dog {
    type Out = u32;
    fn make(&self) -> u32 {
        3
    }
}

pub struct Wrap<T: Make> {
    pub inner: Option<<T as Make>::Out>,
    pub base: T,
}

pub struct Pair<T>(pub T, pub T);

impl<T: Copy> Iterator for Pair<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(self.0)
    }
}

pub fn talk(s: &dyn Speak) -> u32 {
    s.loud() + 2
}

pub fn bits(x: u32) -> u32 {
    x.count_ones() + 2
}

pub fn copy_one(a: &[u8; 4], b: &mut [u8; 4]) -> u8 {
    unsafe { std::ptr::copy(a.as_ptr(), b.as_mut_ptr(), 1) }
    b[0] + 2 as u8
}

pub fn first<I: Iterator>(mut it: I) -> (Option<I::Item>, u32) {
    (it.next(), 2)
}

pub fn wrap<T: Make>(base: T) -> (Wrap<T>, u32) {
    let inner = Some(base.make());
    (Wrap { inner, base }, 2)
}

pub fn use_all() -> u32 {
    let (w, k) = wrap(Dog);
    first(Pair(1u32, 2)).0.unwrap_or(0) + w.inner.unwrap_or(0) + talk(&Dog) + k
}

pub async fn later(x: u32) -> u32 {
    x + 2
}

pub fn run_later() -> impl Future<Output = u32> {
    later(2)
}
