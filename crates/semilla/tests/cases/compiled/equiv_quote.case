=== old src/lib.rs
pub fn quote(n: u32, p: u32) -> u32 {
    let t = n * p;
    if t > 100 { t - 5 } else { t }
}
=== new src/lib.rs
pub fn quote(n: u32, p: u32) -> u32 {
    let total = n * p;
    if total >= 100 { total - 5 } else { total }
}
