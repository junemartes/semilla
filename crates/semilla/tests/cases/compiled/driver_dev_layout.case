[package]
name = "store"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
use std::collections::HashMap;
use std::hash::{BuildHasher, Hash};

pub trait Data {
    type Id: Hash + Eq + Clone;
    fn id(&self) -> Self::Id;
}

pub struct Slot<D: Data> {
    pub id: D::Id,
    pub data: D,
}

pub struct DataContainer<Id, D: Data<Id = Id>, S = std::collections::hash_map::RandomState> {
    map: HashMap<Id, Slot<D>, S>,
    count: usize,
}

impl<Id: Hash + Eq + Clone, D: Data<Id = Id>, S: BuildHasher> DataContainer<Id, D, S> {
    pub fn get(&self, id: &Id) -> Option<&D> {
        let slot = self.map.get(id)? as *const Slot<D>;
        let slot = unsafe { &*slot };
        Some(&slot.data)
    }

    pub fn len(&self) -> usize {
        self.count
    }

    pub fn next(n: usize) -> usize {
        n + 1
    }
}
=== new src/lib.rs
use std::collections::HashMap;
use std::hash::{BuildHasher, Hash};

pub trait Data {
    type Id: Hash + Eq + Clone;
    fn id(&self) -> Self::Id;
}

pub struct Slot<D: Data> {
    pub id: D::Id,
    pub data: D,
}

pub struct DataContainer<Id, D: Data<Id = Id>, S = std::collections::hash_map::RandomState> {
    map: HashMap<Id, Slot<D>, S>,
    count: usize,
}

impl<Id: Hash + Eq + Clone, D: Data<Id = Id>, S: BuildHasher> DataContainer<Id, D, S> {
    pub fn get(&self, id: &Id) -> Option<&D> {
        let slot = self.map.get(id)? as *const Slot<D>;
        let slot = unsafe { &*slot };
        Some(&slot.data)
    }

    pub fn len(&self) -> usize {
        self.count
    }

    pub fn next(n: usize) -> usize {
        n + 2
    }
}
