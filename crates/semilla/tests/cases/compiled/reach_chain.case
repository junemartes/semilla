=== old src/lib.rs
pub fn tier(k: u8) -> u32 {
    match k {
        0 => 2,
        1 => 4,
        _ => 8,
    }
}

pub fn cost(k: u8, n: u32) -> u32 {
    n.wrapping_mul(tier(k))
}

pub fn quote(k: u8, n: u32) -> u32 {
    cost(k, n).wrapping_add(1)
}

pub fn bill(n: u32) -> u32 {
    quote(1, n)
}

pub fn base(n: u32) -> u32 {
    n.wrapping_mul(tier(0))
}

pub fn base_twice(n: u32) -> u32 {
    base(n).wrapping_mul(2)
}

pub fn other(n: u32) -> u32 {
    n.wrapping_add(7)
}
=== new src/lib.rs
pub fn tier(k: u8) -> u32 {
    match k {
        0 => 2,
        1 => 5,
        _ => 8,
    }
}

pub fn cost(k: u8, n: u32) -> u32 {
    n.wrapping_mul(tier(k))
}

pub fn quote(k: u8, n: u32) -> u32 {
    cost(k, n).wrapping_add(1)
}

pub fn bill(n: u32) -> u32 {
    quote(1, n)
}

pub fn base(n: u32) -> u32 {
    n.wrapping_mul(tier(0))
}

pub fn base_twice(n: u32) -> u32 {
    base(n).wrapping_mul(2)
}

pub fn other(n: u32) -> u32 {
    n.wrapping_add(7)
}
