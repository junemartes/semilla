=== old src/lib.rs
pub struct Item(pub u32);
impl Item {
    pub fn cost(&self) -> u32 { self.0 }
}

pub fn total(items: &[Item]) -> u32 {
    items.iter().map(|x| x.cost()).sum()
}
=== new src/lib.rs
pub struct Item(pub u32);
impl Item {
    pub fn cost(&self) -> u32 { self.0 }
}

pub fn total(items: &[Item]) -> u32 {
    items.iter().filter(|x| x.cost() > 0).map(|x| x.cost()).sum()
}
