const N: i32 = 7;
const M: i32 = 6;

pub struct S;
impl S {
    pub const A: u32 = N as u32;
    pub const B: u32 = N as u32;
}

pub fn get() -> u32 {
    S::A + S::B
}
=== new src/lib.rs
const N: i32 = 7;
const M: i32 = 6;

pub struct S;
impl S {
    pub const A: u32 = (M + 1) as u32;
    pub const B: u32 = M as u32;
}

pub fn get() -> u32 {
    S::A + S::B
}
