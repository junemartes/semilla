=== old src/lib.rs
pub trait Speak { fn speak(&self) -> u32; }

pub struct Dog;
pub struct Cat;

impl Speak for Dog { fn speak(&self) -> u32 { 1 } }
impl Speak for Cat { fn speak(&self) -> u32 { 2 } }

pub fn talk(s: &dyn Speak) -> u32 { s.speak() }

pub fn all() -> u32 { talk(&Dog) }
=== new src/lib.rs
pub trait Speak { fn speak(&self) -> u32; }

pub struct Dog;
pub struct Cat;

impl Speak for Dog { fn speak(&self) -> u32 { 1 } }
impl Speak for Cat { fn speak(&self) -> u32 { 2 } }

pub fn talk(s: &dyn Speak) -> u32 { s.speak() }

pub fn all() -> u32 { talk(&Dog).wrapping_add(talk(&Cat)) }
