=== both depot/src/lib.rs
pub trait Size {
    fn size() -> usize;
}

macro_rules! impl_tuple {
    ($($t:ident),*) => {
        impl<$($t: Size),*> Size for ($($t,)*) {
            fn size() -> usize { 0 $(+ $t::size())* }
        }
    };
}

impl Size for u8 { fn size() -> usize { 1 } }

impl_tuple!(A);
impl_tuple!(A, B);
impl_tuple!(A, B, C);
impl_tuple!(A, B, C, D);
=== both depot/src/main.rs
use depot::Size;

macro_rules! show {
    ($t:ty) => { println!("{}", <$t>::size()) };
}

fn main() {
    show!((u8,));
    show!((u8, u8));
}
