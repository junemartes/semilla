=== old src/lib.rs
pub fn total(n: u32, p: u32) -> u32 {
    let mut i = 0;
    let mut sum: u32 = 0;
    while i < n {
        sum = sum.wrapping_add(i.wrapping_mul(p)).wrapping_add(i.wrapping_mul(p));
        i += 1;
    }
    sum
}
=== new src/lib.rs
pub fn total(n: u32, p: u32) -> u32 {
    let mut i = 0;
    let mut sum: u32 = 0;
    while i < n {
        let part = i.wrapping_mul(p);
        sum = sum.wrapping_add(part).wrapping_add(part);
        i += 1;
    }
    sum
}
