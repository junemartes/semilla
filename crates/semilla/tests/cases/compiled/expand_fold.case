=== old src/lib.rs
macro_rules! bump { ($v:expr) => { $v + 1 } }

pub fn a(v: u32) -> u32 { bump!(v) }
pub fn b(v: u32) -> u32 { bump!(v) }
pub fn c(v: u32) -> u32 { bump!(v) }
pub fn d(v: u32) -> u32 { bump!(v) }
pub fn e(w: u32) -> u32 { bump!(w * 2) }
