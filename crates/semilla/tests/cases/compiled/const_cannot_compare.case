pub struct Big<T>(pub T);

impl<T> Big<T> {
    pub const FAR: usize = k0() * core::mem::size_of::<T>();
}

pub fn far<T>(x: usize) -> usize {
    x.wrapping_add(Big::<T>::FAR)
}

pub const RATE: u32 = 7;

pub fn price(n: u32) -> u32 {
    n.wrapping_mul(RATE)
}
