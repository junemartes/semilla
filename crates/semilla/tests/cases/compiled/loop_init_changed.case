=== old src/lib.rs
pub fn acc(n: u32) -> u32 {
    let mut i: u32 = 0;
    let mut sum: u32 = 0;
    while i < n {
        sum = sum.wrapping_add(i);
        i += 1;
    }
    sum
}
=== new src/lib.rs
pub fn acc(n: u32) -> u32 {
    let mut i: u32 = 0;
    let mut sum: u32 = 1;
    while i < n {
        sum = sum.wrapping_add(i);
        i += 1;
    }
    sum
}
