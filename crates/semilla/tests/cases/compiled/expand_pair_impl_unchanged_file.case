=== both src/store.rs
pub trait Store {
    fn get(&self) -> u32;
}

macro_rules! forward {
    () => {
        fn get(&self) -> u32 {
            (**self).get()
        }
    };
}

impl<T: Store + ?Sized> Store for &mut T { forward!(); }
impl<T: Store + ?Sized> Store for Box<T> { forward!(); }
=== both tests/shop.rs
use shop::Store;

struct One;
impl Store for One { fn get(&self) -> u32 { 1 } }

macro_rules! check { ($e:expr) => { assert_eq!($e, 1) } }

#[test]
fn boxed() {
    let b: Box<One> = Box::new(One);
    check!(b.get());
}
