=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub const RATE: u32 = 7;
pub const FEE: u32 = 2;

pub fn price(n: u32) -> u32 {
    n.wrapping_mul(RATE)
}

pub fn fee(n: u32) -> u32 {
    n.wrapping_add(FEE)
}

pub fn cap(n: u32) -> u32 {
    if RATE > 5 { n } else { 0 }
}
=== new src/lib.rs
pub const RATE: u32 = 6;
pub const FEE: u32 = 2;

pub fn price(n: u32) -> u32 {
    n.wrapping_mul(RATE)
}

pub fn fee(n: u32) -> u32 {
    n.wrapping_add(FEE)
}

pub fn cap(n: u32) -> u32 {
    if RATE > 5 { n } else { 0 }
}
