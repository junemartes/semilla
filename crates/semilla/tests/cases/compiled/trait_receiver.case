=== old src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }
pub struct Food;
pub struct Fuel;
impl Tax for Food { fn rate(&self) -> u32 { 5 } }
impl Tax for Fuel { fn rate(&self) -> u32 { if cfg!(unix) { 20 } else { 21 } } }

pub fn price() -> u32 {
    let item = Food;
    item.rate()
}
=== new src/lib.rs
pub trait Tax { fn rate(&self) -> u32; }
pub struct Food;
pub struct Fuel;
impl Tax for Food { fn rate(&self) -> u32 { 5 } }
impl Tax for Fuel { fn rate(&self) -> u32 { if cfg!(unix) { 20 } else { 21 } } }

pub fn price() -> u32 {
    let item = Fuel;
    item.rate()
}
