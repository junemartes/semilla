=== old src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food;

impl Tax for Food {
    fn rate(&self) -> u32 {
        5
    }
}

pub fn charge<T: Tax>(t: &T, n: u32) -> u32 {
    t.rate().wrapping_mul(n)
}

pub fn food_bill(n: u32) -> u32 {
    charge(&Food, n)
}
=== new src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food;

impl Tax for Food {
    fn rate(&self) -> u32 {
        6
    }
}

pub fn charge<T: Tax>(t: &T, n: u32) -> u32 {
    t.rate().wrapping_mul(n)
}

pub fn food_bill(n: u32) -> u32 {
    charge(&Food, n)
}
