=== old src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub fee: u32,
}

impl Cart {
    pub fn total(&self) -> u32 {
        let sum: u32 = self.items.iter().sum();
        sum + self.fee
    }
}
=== new src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub fee: u32,
}

impl Cart {
    pub fn total(&self) -> u32 {
        self.subtotal() + self.fee
    }

    fn subtotal(&self) -> u32 {
        self.items.iter().sum()
    }
}
