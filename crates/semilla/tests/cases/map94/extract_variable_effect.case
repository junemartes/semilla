=== old src/lib.rs
pub fn total(v: &mut Vec<u32>, a: u32) -> usize {
    v.push(1);
    keep(v.len() + a as usize)
}

fn keep(x: usize) -> usize {
    x
}
=== new src/lib.rs
pub fn total(v: &mut Vec<u32>, a: u32) -> usize {
    let s = v.len() + a as usize;
    v.push(1);
    keep(s)
}

fn keep(x: usize) -> usize {
    x
}
