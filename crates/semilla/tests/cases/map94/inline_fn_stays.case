=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = part(a, b);
    s + 1
}

pub fn part(a: u32, b: u32) -> u32 {
    a * 3 + b
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = a * 3 + b;
    s + 1
}

pub fn part(a: u32, b: u32) -> u32 {
    a * 3 + b
}
