=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    a * 3 + b
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    part(a, b).min(piece(a, b))
}

fn part(a: u32, b: u32) -> u32 {
    a * 3 + b
}

fn piece(a: u32, b: u32) -> u32 {
    a * 3 + b
}
