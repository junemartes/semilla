pub struct Pair {
    pub a: u32,
    pub b: u64,
}

pub fn make(x: u32) -> Pair {
    Pair { a: x, b: 2 }
}

pub fn sum(p: &Pair) -> u64 {
    p.a as u64 + p.b
}
