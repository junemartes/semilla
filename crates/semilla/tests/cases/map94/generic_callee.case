=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = a.max(b);
    s + 1
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = part(a, b);
    s + 1
}

fn part<T: Ord>(a: T, b: T) -> T {
    a.max(b)
}
