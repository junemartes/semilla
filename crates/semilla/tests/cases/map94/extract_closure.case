=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = a * 3 + b;
    s + 1
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let part = |x: u32| x * 3 + b;
    let s = part(a);
    s + 1
}
