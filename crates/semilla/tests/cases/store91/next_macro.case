=== both src/macros.rs
macro_rules! double {
    ($x:expr) => {
        $x.wrapping_mul(2)
    };
}
=== old src/lib.rs
#[macro_use]
mod macros;

pub fn twice(a: u32) -> u32 {
    double!(a)
}
=== new src/lib.rs
#[macro_use]
mod macros;

pub fn twice(a: u32) -> u32 {
    double!(a).wrapping_add(0)
}
