=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub fn ping(n: u32) -> u32 { n + 1 }
pub fn pong(n: u32) -> u32 { n + 2 }
pub fn tick(n: u32) -> u32 { n + 3 }
pub fn tock(n: u32) -> u32 { n + 4 }

pub fn run(v: u32) -> u32 {
    let a = ping(v);
    let b = pong(v);
    a ^ b
}
=== new src/lib.rs
pub fn ping(n: u32) -> u32 { n + 1 }
pub fn pong(n: u32) -> u32 { n + 2 }
pub fn tick(n: u32) -> u32 { n + 3 }
pub fn tock(n: u32) -> u32 { n + 4 }

pub fn run(v: u32) -> u32 {
    let c = tick(v);
    let d = tock(v);
    c | d
}
