=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
macro_rules! limit {
    ($v:expr) => { if $v > 9 { 9 } else { $v } };
}

pub fn clamp(v: u32) -> u32 {
    limit!(v)
}
=== new src/lib.rs
macro_rules! limit {
    ($v:expr) => { if $v > 9 { 9 } else if $v < 2 { 2 } else { $v } };
}

pub fn clamp(v: u32) -> u32 {
    limit!(v)
}
