=== old src/lib.rs
pub fn small(n: u32) -> u32 { n + 1 }
pub fn large(n: u32) -> u32 { n * 2 }

pub fn run(v: u32) -> u32 {
    let a = small(v);
    a ^ 3
}
=== new src/lib.rs
pub fn small(n: u32) -> u32 { n + 1 }
pub fn large(n: u32) -> u32 { n * 2 }

pub fn run(v: u32) -> u32 {
    let a = large(v);
    a ^ 3
}
