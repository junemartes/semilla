=== old src/lib.rs
pub fn helper(x: u32) -> u32 {
    x.wrapping_mul(5)
}

pub fn run(v: u32) -> u32 {
    let h = |x: u32| x.wrapping_sub(2);
    h(helper(v))
}
=== new src/lib.rs
pub fn helper(x: u32) -> u32 {
    x.wrapping_mul(5)
}

pub fn run(v: u32) -> u32 {
    let h = |x: u32| helper(x).wrapping_sub(2);
    h(v)
}
