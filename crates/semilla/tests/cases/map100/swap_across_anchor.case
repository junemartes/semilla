=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub fn first(n: u32) -> u32 { n + 1 }
pub fn second(n: u32) -> u32 { n * 2 }

pub fn run(v: u32) -> u32 {
    let a = first(v);
    let n = v ^ 7;
    let b = second(v);
    a + b + n
}
=== new src/lib.rs
pub fn first(n: u32) -> u32 { n + 1 }
pub fn second(n: u32) -> u32 { n * 2 }

pub fn run(v: u32) -> u32 {
    let b = second(v);
    let n = v ^ 7;
    let a = first(v);
    a + b + n
}
