note: design 100 (R100.5-1): an `.await` with a changed operand stays the same source node: one changed `await` point, not an added and a removed point
rule-: R100.5-1
must_match: ~ await
=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub async fn fetch(x: u32) -> u32 {
    x + 3
}

pub async fn sum(a: u32) -> u32 {
    fetch(a).await + 1
}
=== new src/lib.rs
pub async fn fetch(x: u32) -> u32 {
    x + 3
}

pub async fn sum(a: u32) -> u32 {
    fetch(a + 2).await + 1
}
