note: a variant gets a field, and a rewrite changes a body that builds an other variant: the nodes of the type change keep their own entries
rule-: R97.3-1
option: --intent
option: .semilla/intent/step.rs
must_match: holds: the closure pair fits 1 site\(s\)
must_match: ◆ f\d+ type change \(Semilla
=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== both .gitignore
/.semilla/
=== old src/lib.rs
pub enum Kind {
    Other,
    Group { group: usize, len: usize },
}

pub struct Error(pub Kind);

pub fn err(input: &str, bounds: core::ops::Range<usize>) -> Error {
    Error(Kind::Group { group: 4, len: input.len() - 3 })
}
=== new src/lib.rs
pub enum Kind {
    Other(&'static str),
    Group { group: usize, len: usize },
}

pub struct Error(pub Kind);

pub fn err(input: &str, bounds: core::ops::Range<usize>) -> Error {
    Error(Kind::Group { group: 4, len: bounds.len() - 3 })
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite(after::shop::err)]
fn bounds_len() {
    (|s: &str, b: core::ops::Range<usize>| s.len(), |s: &str, b: core::ops::Range<usize>| b.len())
}
