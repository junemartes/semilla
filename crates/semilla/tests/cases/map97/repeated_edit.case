=== old src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

pub fn first(c: &Cart) -> usize {
    c.items.len() + 1
}

pub fn second(other: &Cart) -> usize {
    other.items.len() * 2
}
=== new src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

pub fn first(c: &Cart) -> usize {
    c.count + 1
}

pub fn second(other: &Cart) -> usize {
    other.count * 2
}
