=== both .gitignore
/.semilla/
=== old src/lib.rs
pub fn f(a: u32) -> u32 {
    let x = a.wrapping_add(1);
    x.wrapping_mul(2)
}
=== new src/lib.rs
pub fn f(a: u32) -> u32 {
    let x = u32::wrapping_add(a, 1);
    x.wrapping_mul(3)
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite(after::shop::f)]
fn add_one() {
    (|a: u32| a.wrapping_add(1), |a: u32| u32::wrapping_add(a, 1))
}
