=== old src/lib.rs
fn base(a: u32) -> u32 {
    a + 7
}

fn other(a: u32) -> u32 {
    a ^ 7
}

pub fn first(a: u32) -> u32 {
    base(a).rotate_left(3)
}

pub fn second(b: u32) -> u32 {
    base(b).rotate_left(3) ^ 1
}
=== new src/lib.rs
fn base(a: u32) -> u32 {
    a + 7
}

fn other(a: u32) -> u32 {
    a ^ 7
}

pub fn first(a: u32) -> u32 {
    other(a).rotate_left(3)
}

pub fn second(b: u32) -> u32 {
    other(b).rotate_left(3) ^ 1
}
