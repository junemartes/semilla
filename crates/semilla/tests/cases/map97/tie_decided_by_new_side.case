=== both Cargo.toml
[package]
name = "shop"
version = "0.1.0"
edition = "2021"
=== both .gitignore
/.semilla/
=== old src/lib.rs
pub fn f(x: u32, y: u32) -> u32 {
    (x ^ y).rotate_left(3)
}
=== new src/lib.rs
pub fn f(x: u32, y: u32) -> u32 {
    x.wrapping_sub(y).rotate_left(3)
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite(after::shop::f)]
fn sub() {
    (|a: u32, b: u32| a ^ b, |a: u32, b: u32| a.wrapping_sub(b))
}
