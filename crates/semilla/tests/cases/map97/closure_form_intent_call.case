=== old src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

impl Cart {
    pub fn total(&self) -> usize {
        self.items.len() + 1
    }

    pub fn twice(&self) -> usize {
        self.items.len() * 2
    }
}
=== new src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

impl Cart {
    pub fn total(&self) -> usize {
        self.count + 1
    }

    pub fn twice(&self) -> usize {
        self.count * 2
    }
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

fn length(c: &before::shop::Cart) -> usize {
    c.items.len()
}

#[rewrite]
fn count() {
    (|c: &before::shop::Cart| length(c), |c: &after::shop::Cart| c.count)
}
