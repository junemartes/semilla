=== old src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

pub struct Bag {
    pub items: Vec<u32>,
}

impl Cart {
    pub fn size(&self) -> usize {
        self.items.len()
    }
}

impl Bag {
    pub fn size(&self) -> usize {
        self.items.len()
    }
}

pub fn total(b: &Bag) -> usize {
    b.size() + 1
}
=== new src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

pub struct Bag {
    pub items: Vec<u32>,
}

impl Cart {
    pub fn size(&self) -> usize {
        self.items.len()
    }
}

impl Bag {
    pub fn size(&self) -> usize {
        self.items.len()
    }
}

pub fn total(b: &Bag) -> usize {
    b.items.len() + 1
}
=== new .semilla/intent/step.rs
use semilla_intent::prelude::*;

#[rewrite(after::shop::total)]
fn size() {
    (|c: &before::shop::Bag| c.size(), |c: &after::shop::Bag| c.items.len())
}
