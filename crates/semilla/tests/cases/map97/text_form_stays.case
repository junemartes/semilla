=== old src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

impl Cart {
    pub fn total(&self) -> usize {
        self.items.len() + 1
    }

    pub fn twice(&self) -> usize {
        self.items.len() * 2
    }
}
=== new src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

impl Cart {
    pub fn total(&self) -> usize {
        self.count + 1
    }

    pub fn twice(&self) -> usize {
        self.count * 2
    }
}
