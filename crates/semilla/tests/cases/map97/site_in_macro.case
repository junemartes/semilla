=== old src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

macro_rules! size {
    ($c:expr) => {
        $c.items.len()
    };
}

pub fn total(c: &Cart) -> usize {
    size!(c) + 1
}
=== new src/lib.rs
pub struct Cart {
    pub items: Vec<u32>,
    pub count: usize,
}

macro_rules! size {
    ($c:expr) => {
        $c.count
    };
}

pub fn total(c: &Cart) -> usize {
    size!(c) + 1
}
