=== old src/lib.rs
pub struct Cart { pub total: u32, pub items: Vec<u32> }
impl Cart {
    pub fn total(&self) -> u32 { self.total }
    pub fn count(&self) -> usize { self.items.len() }
}
pub fn a(c: &Cart) -> u32 { c.total + 1 }
pub fn b(c: &Cart) -> u32 { c.total * 2 }
pub fn both(c: &Cart, d: &Cart) -> u32 { wrap(c.total + 1) + d.total }
pub fn wrap(x: u32) -> u32 { x }
pub fn wrap2(x: u32) -> u32 { x }
pub fn limit() -> u32 { 10 }
pub fn uses_limit() -> u32 { limit() + limit() }
/// Gives three.
pub fn idle() -> u32 { 3 }
pub enum Mode { Idle, Busy }
pub fn mode_name(m: &Mode) -> &'static str { match m { Mode::Idle => "idle", Mode::Busy => "busy" } }
pub mod conf { pub fn depth() -> u32 { 4 } }
#[cfg(test)]
mod tests { use super::*; #[test] fn t_limit() { assert_eq!(limit(), 10); } }
=== new src/lib.rs
pub struct Cart { pub total: u32, pub items: Vec<u32> }
impl Cart {
    pub fn total(&self) -> u32 { self.total }
    pub fn count(&self) -> usize { self.items.len() }
}
pub fn a(c: &Cart) -> u32 { c.total + 1 }
pub fn b(c: &Cart) -> u32 { c.total * 2 }
pub fn both(c: &Cart, d: &Cart) -> u32 { wrap(c.total + 1, limit() * 3) + d.total }
pub fn wrap(x: u32, by: u32) -> u32 { x }
pub fn wrap2(x: u32) -> u32 { x }
pub fn limit() -> u32 { 10 }
pub fn uses_limit() -> u32 { limit() + limit() + 1 }
/// Gives three.
pub fn idle() -> u32 { 3 }
pub enum Mode { Idle, Busy }
pub fn mode_name(m: &Mode) -> &'static str { match m { Mode::Idle => "idle", Mode::Busy => "busy" } }
pub mod conf { pub fn depth() -> u32 { 4 } }
#[cfg(test)]
mod tests { use super::*; #[test] fn t_limit() { assert_eq!(limit(), 10); } }
