note: design 54.4: in a rejected step, the last line of the gap list names the options for the command of the step. No step is stored.
note: the negative case is `rules/gap_list_lines`: an accepted step names the command `semilla fact`.
rule+: R54.4-7
option: --change
option: idle=more
exit: 1
must_match: \n  to state them, add these options to the command of the step: --change 'depot::limit=TEXT'\n
must_not_match: add facts to the stored step
must_not_match: semilla fact
=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub struct Cart { pub total: u32, pub items: Vec<u32> }
impl Cart {
    pub fn total(&self) -> u32 { self.total }
    pub fn count(&self) -> usize { self.items.len() }
}
pub fn a(c: &Cart) -> u32 { c.total + 1 }
pub fn b(c: &Cart) -> u32 { c.total * 2 }
pub fn both(c: &Cart, d: &Cart) -> u32 { wrap(c.total + 1) + d.total }
pub fn wrap(x: u32) -> u32 { x }
pub fn wrap2(x: u32) -> u32 { x }
pub fn limit() -> u32 { 10 }
pub fn uses_limit() -> u32 { limit() + limit() }
/// Gives three.
pub fn idle() -> u32 { 3 }
pub enum Mode { Idle, Busy }
pub fn mode_name(m: &Mode) -> &'static str { match m { Mode::Idle => "idle", Mode::Busy => "busy" } }
pub mod conf { pub fn depth() -> u32 { 4 } }
#[cfg(test)]
mod tests { use super::*; #[test] fn t_limit() { assert_eq!(limit(), 10); } }
=== new src/lib.rs
pub struct Cart { pub total: u32, pub items: Vec<u32> }
impl Cart {
    pub fn total(&self) -> u32 { self.total }
    pub fn count(&self) -> usize { self.items.len() }
}
pub fn a(c: &Cart) -> u32 { c.total + 1 }
pub fn b(c: &Cart) -> u32 { c.total * 2 }
pub fn both(c: &Cart, d: &Cart) -> u32 { wrap(c.total + 1) + d.total }
pub fn wrap(x: u32) -> u32 { x }
pub fn wrap2(x: u32) -> u32 { x }
pub fn limit() -> u32 { 11 }
pub fn uses_limit() -> u32 { limit() + limit() }
/// Gives three.
pub fn idle() -> u32 { 3 }
pub enum Mode { Idle, Busy }
pub fn mode_name(m: &Mode) -> &'static str { match m { Mode::Idle => "idle", Mode::Busy => "busy" } }
pub mod conf { pub fn depth() -> u32 { 4 } }
#[cfg(test)]
mod tests { use super::*; #[test] fn t_limit() { assert_eq!(limit(), 10); } }
