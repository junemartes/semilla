=== new src/lib.rs
pub struct Slab;

impl Slab {
    #[cfg(unix)]
    pub fn name(&self) -> &'static str {
        "one"
    }

    #[doc = "Not under #[cfg(test)]."]
    #[inline]
    #[cfg(not(unix))]
    pub fn name(&self) -> &'static str {
        #[cfg(debug_assertions)]
        { return "debug"; }
        "two"
    }
}
