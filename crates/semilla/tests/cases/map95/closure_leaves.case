=== old src/lib.rs
fn apply(f: impl Fn(u32) -> u32, a: u32) -> u32 {
    f(a)
}

pub fn total(a: u32, b: u32) -> u32 {
    let part = |x: u32| x.wrapping_mul(3) ^ b;
    let s = a.wrapping_mul(3) ^ b;
    s.rotate_left(1) ^ apply(part, 0)
}
=== new src/lib.rs
fn apply(f: impl Fn(u32) -> u32, a: u32) -> u32 {
    f(a)
}

pub fn total(a: u32, b: u32) -> u32 {
    let part = |x: u32| x.wrapping_mul(3) ^ b;
    let s = part(a);
    s.rotate_left(1) ^ apply(part, 0)
}
