=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let x = a ^ 2;
    let y = b | 3;
    let s = x.wrapping_mul(3) ^ y;
    s.rotate_left(1)
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let y = b | 3;
    let x = a ^ 2;
    let s = part(x, y);
    s.rotate_left(1)
}

fn part(x: u32, y: u32) -> u32 {
    x.wrapping_mul(5) ^ y
}
