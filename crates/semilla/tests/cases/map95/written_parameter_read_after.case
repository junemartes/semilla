=== old src/lib.rs
pub fn total(mut a: u32) -> u32 {
    a = a.wrapping_add(1);
    let r = a.wrapping_mul(2);
    r ^ a
}
=== new src/lib.rs
#[allow(unused_mut)]
pub fn total(mut a: u32) -> u32 {
    let r = part(a);
    r ^ a
}

fn part(mut a: u32) -> u32 {
    a = a.wrapping_add(1);
    a.wrapping_mul(2)
}
