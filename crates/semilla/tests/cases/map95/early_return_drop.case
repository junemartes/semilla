=== old src/lib.rs
pub fn total(a: u32, s: String) -> usize {
    let n = if a > 9 { 0 } else { s.len() };
    let m = n.wrapping_add(1);
    drop(s);
    m
}
=== new src/lib.rs
pub fn total(a: u32, s: String) -> usize {
    let n = part(a, s);
    let m = n.wrapping_add(1);
    m
}

fn part(a: u32, s: String) -> usize {
    if a > 9 {
        return 0;
    }
    s.len()
}
