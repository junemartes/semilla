=== old src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food(pub u32);

impl Tax for Food {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(3)
    }
}

pub fn total(f: &Food) -> u32 {
    f.0.wrapping_mul(3) ^ 1
}
=== new src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food(pub u32);

impl Tax for Food {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(3)
    }
}

pub fn total(f: &Food) -> u32 {
    f.rate() ^ 1
}
