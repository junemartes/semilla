=== old src/lib.rs
use std::sync::atomic::{AtomicU32, Ordering};

static HITS: AtomicU32 = AtomicU32::new(0);

fn load() -> u32 {
    HITS.load(Ordering::Relaxed)
}

fn bump(b: u32) -> u32 {
    HITS.fetch_add(1, Ordering::Relaxed) ^ b
}

pub fn total(b: u32) -> u32 {
    let x = load();
    let y = bump(b);
    x ^ y
}
=== new src/lib.rs
use std::sync::atomic::{AtomicU32, Ordering};

static HITS: AtomicU32 = AtomicU32::new(0);

fn load() -> u32 {
    HITS.load(Ordering::Relaxed)
}

fn bump(b: u32) -> u32 {
    HITS.fetch_add(1, Ordering::Relaxed) ^ b
}

pub fn total(b: u32) -> u32 {
    let y = bump(b);
    let x = load();
    x ^ y
}
