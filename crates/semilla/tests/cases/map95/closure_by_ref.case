=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = a.wrapping_mul(3) ^ b;
    s.rotate_left(1)
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let part = |x: u32| x.wrapping_mul(3) ^ b;
    let s = part(a);
    s.rotate_left(1)
}
