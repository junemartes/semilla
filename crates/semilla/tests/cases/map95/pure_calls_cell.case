=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
use std::cell::Cell;

fn read(c: &Cell<u32>) -> u32 {
    c.get()
}

fn write(c: &Cell<u32>, v: u32) -> u32 {
    c.set(v);
    v
}

pub fn total(c: &Cell<u32>, v: u32) -> u32 {
    let x = read(c);
    let y = write(c, v);
    x ^ y
}
=== new src/lib.rs
use std::cell::Cell;

fn read(c: &Cell<u32>) -> u32 {
    c.get()
}

fn write(c: &Cell<u32>, v: u32) -> u32 {
    c.set(v);
    v
}

pub fn total(c: &Cell<u32>, v: u32) -> u32 {
    let y = write(c, v);
    let x = read(c);
    x ^ y
}
