=== old src/lib.rs
fn keep(x: u32) -> u32 {
    x.rotate_left(3)
}

pub fn total(a: u32, b: u32) -> u32 {
    let t = a ^ 5;
    keep(a.wrapping_mul(3) ^ b) ^ t
}
=== new src/lib.rs
fn keep(x: u32) -> u32 {
    x.rotate_left(3)
}

pub fn total(a: u32, b: u32) -> u32 {
    let t = a ^ 6;
    let s = a.wrapping_mul(3) ^ b;
    keep(s) ^ t
}
