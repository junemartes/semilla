=== old src/lib.rs
pub fn total(a: u32) -> u32 {
    let s = if a > 9 { 0 } else { a.wrapping_mul(2) };
    s.wrapping_add(1)
}
=== new src/lib.rs
pub fn total(a: u32) -> u32 {
    let s = part(a);
    s.wrapping_add(1)
}

fn part(a: u32) -> u32 {
    if a > 9 {
        return 0;
    }
    a.wrapping_mul(2)
}
