=== old src/lib.rs
fn f(a: u32) -> u32 {
    a.wrapping_mul(7)
}

fn g(b: u32) -> u32 {
    b.rotate_right(2)
}

pub fn total(a: u32, b: u32) -> u32 {
    let x = f(a);
    let y = g(b);
    x ^ y
}
=== new src/lib.rs
fn f(a: u32) -> u32 {
    a.wrapping_mul(7)
}

fn g(b: u32) -> u32 {
    b.rotate_right(2)
}

pub fn total(a: u32, b: u32) -> u32 {
    let y = g(b);
    let x = f(a);
    x ^ y
}
