=== old src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = a.max(b);
    s.wrapping_add(1)
}
=== new src/lib.rs
pub fn total(a: u32, b: u32) -> u32 {
    let s = larger(a, b);
    s.wrapping_add(1)
}

fn larger<T: Ord>(a: T, b: T) -> T {
    a.max(b)
}
