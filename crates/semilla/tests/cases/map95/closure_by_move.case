must_not_match: ◆ f\d+ extract \(Semilla; R95\.6-1, the MIR of `depot::total::\{closure#0\}` put in at the call is the MIR of the old code
=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub fn total(a: usize, s: String) -> usize {
    let n = a.wrapping_add(s.len());
    n.rotate_left(1)
}
=== new src/lib.rs
pub fn total(a: usize, s: String) -> usize {
    let part = move |x: usize| x.wrapping_add(s.len());
    let n = part(a);
    n.rotate_left(1)
}
