=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food(pub u32);
pub struct Fuel(pub u32);

impl Tax for Food {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(3)
    }
}

impl Tax for Fuel {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(5)
    }
}

pub fn total(f: &Food, u: &Fuel) -> u32 {
    let _ = u;
    f.rate() ^ 1
}
=== new src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food(pub u32);
pub struct Fuel(pub u32);

impl Tax for Food {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(3)
    }
}

impl Tax for Fuel {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(5)
    }
}

pub fn total(f: &Food, u: &Fuel) -> u32 {
    let _ = f;
    taxed(u) ^ 1
}

fn taxed<T: Tax>(x: &T) -> u32 {
    x.rate()
}
