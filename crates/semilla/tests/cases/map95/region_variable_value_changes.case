=== old src/lib.rs
const K: u32 = 3;

fn keep(x: u32) -> u32 {
    x.rotate_left(3)
}

pub fn total(a: u32, b: u32) -> u32 {
    keep(a.wrapping_mul(K) ^ b)
}
=== new src/lib.rs
const K: u32 = 4;

fn keep(x: u32) -> u32 {
    x.rotate_left(3)
}

pub fn total(a: u32, b: u32) -> u32 {
    let s = a.wrapping_mul(K) ^ b;
    keep(s)
}
