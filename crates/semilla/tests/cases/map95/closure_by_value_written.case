=== old src/lib.rs
pub fn total(a: u32, mut b: u32) -> u32 {
    b = b.wrapping_add(1);
    let s = a.wrapping_mul(3) ^ b;
    s.rotate_left(1) ^ b
}
=== new src/lib.rs
pub fn total(a: u32, mut b: u32) -> u32 {
    let part = move |x: u32| x.wrapping_mul(3) ^ b;
    b = b.wrapping_add(1);
    let s = part(a);
    s.rotate_left(1) ^ b
}
