=== both Cargo.toml
[package]
name = "depot"
version = "0.1.0"
edition = "2021"
=== old src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food(pub u32);

impl Tax for Food {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(3)
    }
}

pub fn total(f: &Food, d: &dyn Tax) -> u32 {
    let _ = d;
    f.0.wrapping_mul(3) ^ 1
}
=== new src/lib.rs
pub trait Tax {
    fn rate(&self) -> u32;
}

pub struct Food(pub u32);

impl Tax for Food {
    fn rate(&self) -> u32 {
        self.0.wrapping_mul(3)
    }
}

pub fn total(f: &Food, d: &dyn Tax) -> u32 {
    let _ = f;
    d.rate() ^ 1
}
