=== old src/lib.rs
fn f(a: u32) -> u32 {
    a * 7
}

fn g(b: u32) -> u32 {
    b + 9
}

pub fn total(a: u32, b: u32) -> u32 {
    let x = f(a);
    let y = g(b);
    x ^ y
}
